<Project>
    <PropertyGroup>
        <_ViuBrowserSdk>true</_ViuBrowserSdk>
        <!-- Public generated-asset hot-reload contract advertised by the Browser SDK.
             Exact-version consumers remain inert when this value is absent or incompatible.
             Specified by [V01.01.12.30.04], issue #355. -->
        <ViuGeneratedAssetSeamVersion>1</ViuGeneratedAssetSeamVersion>
        <ViuBrowserTaskAssembly Condition="'$(ViuBrowserTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\Tasks\Assimalign.Viu.Sdk.Browser.Tasks.dll</ViuBrowserTaskAssembly>
        <ViuInjectCssBundleLinkTaskAssembly Condition="'$(ViuInjectCssBundleLinkTaskAssembly)' == ''">$(ViuBrowserTaskAssembly)</ViuInjectCssBundleLinkTaskAssembly>
        <ViuCssHotReloadTaskAssembly Condition="'$(ViuCssHotReloadTaskAssembly)' == ''">$(ViuBrowserTaskAssembly)</ViuCssHotReloadTaskAssembly>
        <ViuCssHotReloadWorkerAssembly Condition="'$(ViuCssHotReloadWorkerAssembly)' == ''">$(MSBuildThisFileDirectory)..\Watch\Assimalign.Viu.Sdk.CssHotReload.dll</ViuCssHotReloadWorkerAssembly>
        <ViuBrowserRunHostAssembly Condition="'$(ViuBrowserRunHostAssembly)' == ''">$(MSBuildThisFileDirectory)..\RunHost\Assimalign.Viu.Sdk.Browser.RunHost.dll</ViuBrowserRunHostAssembly>
        <ViuBrowserRunHostReadinessEnabled Condition="'$(ViuBrowserRunHostReadinessEnabled)' == ''">true</ViuBrowserRunHostReadinessEnabled>
        <MetadataUpdaterSupport Condition="'$(MetadataUpdaterSupport)' == '' and '$(Configuration)' == 'Debug' and '$(WasmEnableHotReload)' != 'false'">true</MetadataUpdaterSupport>
        <!-- dotnet watch captures $(CustomCollectWatchItems) while Microsoft.Common targets are
             imported. Register the Browser SDK's generated-asset collector from this early props
             import so every GenerateWatchList evaluation invokes it. The target retains the
             Debug, watch, and design-time conditions that keep ordinary build and publish inert.
             Specified by [V01.01.12.33], issue #356. -->
        <CustomCollectWatchItems>$(CustomCollectWatchItems);_ViuCollectGeneratedAssetHotReloadWatchItems</CustomCollectWatchItems>
    </PropertyGroup>
</Project>
