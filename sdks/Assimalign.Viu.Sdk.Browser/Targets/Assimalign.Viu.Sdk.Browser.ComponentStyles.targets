<Project>
    <!-- [PKG-STYLE-1] Query each resolved reference after its build, ignoring non-Viu targets. -->
    <Target Name="ViuCollectReferencedComponentLibraryStyles"
            DependsOnTargets="ResolveProjectReferences"
            Condition="'$(UsingMicrosoftNETSdkWebAssembly)' == 'true'">
        <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
                 Targets="GetViuComponentLibraryStyles"
                 BuildInParallel="$(BuildInParallel)"
                 SkipNonexistentTargets="true"
                 Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)"
                 RemoveProperties="RuntimeIdentifier;SelfContained;OutputType;PublishDir;OutputPath;IntermediateOutputPath"
                 Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
            <Output TaskParameter="TargetOutputs" ItemName="ViuComponentLibraryStyle" />
        </MSBuild>
    </Target>

    <!-- Flow styles extracted by component-library packages and projects into Browser output. -->
    <Target Name="ViuFlowComponentLibraryStyles"
            BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
            DependsOnTargets="ViuCollectReferencedComponentLibraryStyles"
            Condition="'$(UsingMicrosoftNETSdkWebAssembly)' == 'true'">
        <ItemGroup>
            <_ViuComponentLibraryStyle Include="@(ViuComponentLibraryStyle->Distinct())" KeepMetadata="PackageId" />
            <_ViuComponentLibraryStyleDestination Include="@(_ViuComponentLibraryStyle->'wwwroot/_content/%(PackageId)/%(Filename)%(Extension)')" />
        </ItemGroup>
        <Copy SourceFiles="@(_ViuComponentLibraryStyle)"
              DestinationFiles="@(_ViuComponentLibraryStyleDestination->'%(FullPath)')"
              Condition="'@(_ViuComponentLibraryStyle)' != ''"
              SkipUnchangedFiles="true" />
        <ItemGroup>
            <!--
                A preceding Build leaves the copied file under wwwroot, so the
                next Publish evaluation discovers it through the SDK's default
                Content glob with an OS-native item identity. Match on FullPath
                rather than item identity to replace that entry deterministically
                on Windows and Unix and avoid duplicate static-web-asset keys.
            -->
            <Content Remove="@(_ViuComponentLibraryStyleDestination)"
                     MatchOnMetadata="FullPath"
                     MatchOnMetadataOptions="PathLike" />
            <Content Include="@(_ViuComponentLibraryStyleDestination)" KeepMetadata="">
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
                <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            </Content>
            <_ViuComponentLibraryStyle Remove="@(_ViuComponentLibraryStyle)" />
            <_ViuComponentLibraryStyleDestination Remove="@(_ViuComponentLibraryStyleDestination)" />
        </ItemGroup>
    </Target>
</Project>
