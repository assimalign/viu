<Project>
  <!--
    Flow every canonical .viu and tag-based .vue single-file component to the
    Assimalign.Viu.Generators.Syntax source generator as an AdditionalFile
    ([V01.01.06.02]/[V01.01.06.09]). This ItemGroup is evaluated at import time (after the consuming
    project's own items and the SDK default excludes are known), so the files are visible to the compiler
    without the consumer editing their csproj. The same files flow to dotnet watch so an edit restarts the
    generator/build pipeline.

    THE single authoritative copy - packed into the Assimalign.Viu.Sdk nupkg and imported by
    Sdk/Sdk.targets for packaged consumers, and imported directly by
    build/Targets/Build.References.Analyzers.targets for in-repo dogfooding. See the paired .props for
    the two-home policy that puts it here rather than beside the analyzer's src/.

    Opt a single file out by adding it to ViuSingleFileComponentExclude, e.g.:
        <ItemGroup>
          <ViuSingleFileComponentExclude Include="Experimental.viu;Experimental.vue" />
        </ItemGroup>
    Disable the whole feature with <EnableSingleFileComponentGeneration>false</EnableSingleFileComponentGeneration>.
  -->
  <ItemGroup Condition="'$(EnableSingleFileComponentGeneration)' == 'true'">
    <ViuSingleFileComponent Include="**/*.viu;**/*.vue"
                              Exclude="@(ViuSingleFileComponentExclude);$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <!-- KeepDuplicates=false guards against a file also being added by hand: two AdditionalText entries
         with the same path would produce duplicate generated hint names and fail the build. -->
    <AdditionalFiles Include="@(ViuSingleFileComponent)" KeepDuplicates="false" />
  </ItemGroup>

  <!-- dotnet watch invokes $(CustomCollectWatchItems) after its core items are available. Extend that hook
       instead of evaluating @(Watch) above so source-item metadata can be batched legally. -->
  <PropertyGroup Condition="'$(EnableSingleFileComponentGeneration)' == 'true'">
    <CustomCollectWatchItems>$(CustomCollectWatchItems);_ViuCollectSingleFileComponentGeneratorWatchItems</CustomCollectWatchItems>
  </PropertyGroup>

  <Target Name="_ViuCollectSingleFileComponentGeneratorWatchItems"
          Condition="'$(EnableSingleFileComponentGeneration)' == 'true'">
    <ItemGroup>
      <!-- Use absolute paths (matching the Razor SDK) and honor Watch=false metadata for a deliberately
           excluded component. Build.Css.Bundling.targets repeats this for bundling-only consumers;
           KeepDuplicates=false makes the overlap harmless. -->
      <Watch Include="%(ViuSingleFileComponent.FullPath)"
             Condition="'%(ViuSingleFileComponent.Watch)' != 'false'"
             KeepDuplicates="false" />
    </ItemGroup>
  </Target>
</Project>
