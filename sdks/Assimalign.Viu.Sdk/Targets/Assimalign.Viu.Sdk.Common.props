<Project>
    <PropertyGroup>
        <_ViuSdk>true</_ViuSdk>
        <!--
            Public project-system marker used by the Visual Studio extension's activation
            constraint. This keeps the .vue compatibility document filter dormant in solutions
            that do not contain a Viu SDK project. A consumer may opt out without disabling the
            build-time SDK by setting the property to false in the project body.
        -->
        <ViuVisualStudioLanguageServiceEnabled Condition="'$(ViuVisualStudioLanguageServiceEnabled)' == ''">true</ViuVisualStudioLanguageServiceEnabled>

        <!--
            Single-file components are on by default: a component-library project
            using Assimalign.Viu.Sdk compiles .viu/.vue files with zero wiring.
            Consumers can set either property to false in their csproj body - property
            evaluation is document-ordered, so the body assignment wins over
            these defaults.
        -->
        <ViuUseSingleFileComponents Condition="'$(ViuUseSingleFileComponents)' == ''">true</ViuUseSingleFileComponents>
        <!--
            [SSR-TARGET-1] Server rendering is an explicit project topology, never inferred from
            source files. A project body may set this to true; the final value is visible to the
            generator and the paired targets add the exact ServerRenderer package.
        -->
        <ViuServerRendering Condition="'$(ViuServerRendering)' == ''">false</ViuServerRendering>

        <!--
            The ViuBundleCss MSBuild task ships inside this SDK package at
            Tasks/ (with its parser dependency closure alongside). Presetting
            the assembly path here keeps the packed ComponentStyles.targets'
            in-repo default path (which needs $(ViuRepositoryDirectory))
            dormant.
        -->
        <ViuBundleCssTaskAssembly Condition="'$(ViuBundleCssTaskAssembly)' == ''">$(MSBuildThisFileDirectory)..\Tasks\Assimalign.Viu.Sdk.Tasks.dll</ViuBundleCssTaskAssembly>
        <LangVersion Condition="'$(LangVersion)' == ''">preview</LangVersion>
        <Nullable Condition="'$(Nullable)' == ''">enable</Nullable>
    </PropertyGroup>
</Project>
