<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<!-- The Tasks csproj is the packable unit: its PackageId is the SDK id
		     (not ...Tasks), IncludeBuildOutput=false (sdks/Directory.Build.props)
		     keeps the DLLs out of lib/, and sdks/Directory.Build.targets places
		     Sdk/, Targets/, Tasks/, and assets/ at the nupkg root - the shape
		     NuGet's MSBuild SDK resolver expects. -->
		<PackageId>Assimalign.Viu.Sdk</PackageId>
		<!--
			Deviates from the repo SDK target-framework rule per design decision:
			an MSBuild task must load in-process under both Visual Studio's .NET
			Framework MSBuild and the dotnet CLI's .NET MSBuild. A net10.0 task
			cannot load in Visual Studio's full-framework process, while the
			cross-runtime task-host workaround fails on ARM64 (MSB4216). The
			shared tooling closure already targets this netstandard2.0 alias.
		-->
		<TargetFramework>$(TargetFrameworkForAnalyzers)</TargetFramework>
		<GenerateDependencyFile>true</GenerateDependencyFile>
		<OutDir>$(ViuOutputPathForSdk)\$(NETCoreSdkVersion)\sdks\$(PackageId)\Tasks</OutDir>
	</PropertyGroup>

	<ItemGroup>
		<!-- The shared build-time CSS composition core ([V01.01.12.12]): the task re-runs the SAME deterministic
         @style compilation the generator runs, over the same .viu inputs, so the physical bundle is
         byte-identical to the generated ExtractedStyles constant. Its transitive parser closure
         (Syntax / SingleFileComponent / Templates / Css) copies to the task output for MSBuild to load. -->
		<ViuPrivateProjectReference Include="Assimalign.Viu.Compiler.Css" />
		<!-- The standalone utility candidate scanner/compiler ([V01.01.12.16], #159). Its output remains
		     separate from component @style CSS and it brings no Tailwind, Node, or runtime dependency. -->
		<ViuPrivateProjectReference Include="Assimalign.Viu.UtilityCss" />
	</ItemGroup>
	<ItemGroup>
		<!-- Build-order-only edge: the development worker is packaged beside the netstandard2.0
		     tasks but must not enter their compile/runtime dependency closure. The central by-name
		     resolver preserves this explicit metadata when it emits the ProjectReference. -->
		<ViuPrivateProjectReference Include="Assimalign.Viu.Sdk.CssHotReload"
		                            ReferenceOutputAssembly="false"
		                            SkipGetTargetFrameworkProperties="true"
		                            Private="false" />
	</ItemGroup>
	 <ItemGroup>
    <!-- MSBuild task API. Centrally versioned with ExcludeAssets=runtime (see
         build/Targets/Build.References.Packages.targets) — compile against them but never copy them to
         output; the hosting MSBuild engine supplies these assemblies at run time. -->
    <ViuPackageReference Include="Microsoft.Build.Utilities.Core" />
    <ViuPackageReference Include="Microsoft.Build.Framework" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Roslyn closure that rides the parser graph (Compiler.Css -> Syntax.Templates, whose
         template expressions are parsed with the real C# parser) is compile-time-only for THIS host:
         the bundling task composes the style-only parsers
         (SingleFileComponentParserFactory.CreateForStyleExtraction), which never dispatch template
         content, and the v-bind()/module/scoped rewrites live in Assimalign.Viu.Syntax.Css with no
         Roslyn dependency — Roslyn-backed expression compilation of the recorded bindings runs only
         in the source generator, where the compiler host supplies Roslyn. Re-declaring the closure
         with ExcludeAssets=runtime (each member, because asset exclusion is not transitive) keeps
         CopyLocalLockFileAssemblies from sweeping the ~26 MB compiler set (satellites included) into
         the packaged Tasks/ payload and keeps the deps.json truthful; the packaging lane asserts the
         resulting shape ([V01.01.12.19.04]). PrivateAssets=all keeps the SDK nuspec
         dependency-free, the same stance as the Microsoft.Build references above. Versions are
         central; this list tracks the Microsoft.CodeAnalysis.CSharp closure pinned in
         Build.References.Packages.targets. -->
    <ViuPackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="Microsoft.CodeAnalysis.Common" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Buffers" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Collections.Immutable" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Memory" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Numerics.Vectors" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Reflection.Metadata" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Runtime.CompilerServices.Unsafe" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Text.Encoding.CodePages" PrivateAssets="all" ExcludeAssets="runtime" />
    <ViuPackageReference Include="System.Threading.Tasks.Extensions" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
