<template>
<main>
  <h2>{{ Title }}</h2>
  <button @click="Raise">raise</button>
  <SlotChild><input ref="Input" v-model="Model" /><p>{{ Model }}</p></SlotChild>
</main>
</template>

@script {
using Assimalign.Viu.Components;
using Assimalign.Viu.Reactivity;

[Parameter(IsRequired = true)]
public string Title { get; set; } = "Default";

[Event]
public partial void Changed(string value);

public Reference<object?> Model = Reactive.Reference<object?>("initial");
public object? Input;

private void Raise() => Changed(Title);
}
