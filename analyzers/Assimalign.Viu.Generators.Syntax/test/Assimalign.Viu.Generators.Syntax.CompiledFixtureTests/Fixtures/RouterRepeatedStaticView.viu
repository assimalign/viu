<template>
<section class="compiled-repeated-route">
  <ol>
    <li v-for="signal in Signals" :key="signal">
      <RouterAliasedSlotHost>
        <template #default>
          <span class="signal-dot" aria-hidden="true"></span>
        </template>
        <template #replacement>
          <strong class="replacement">updated</strong>
        </template>
      </RouterAliasedSlotHost>
      <code>{{ signal }}</code>
    </li>
  </ol>
</section>
</template>

@script {
using System.Collections.Generic;

public IReadOnlyList<string> Signals { get; } =
    new[] { "reference:tracked", "computed:cached", "effect:scheduled" };
}
