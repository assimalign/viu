<template>
<main class="compiled-router-outlet">
  <component :is="TransitionTarget">
    <section :key="CurrentPath" class="compiled-route-frame">
      <component :is="RouterViewTarget"></component>
    </section>
  </component>
</main>
</template>

@script {
using System;

using ViuRouter = Assimalign.Viu.Router.Router;

private ViuRouter Router { get; set; } = null!;

public string CurrentPath => Router.CurrentRoute.Value.Path;

public object RouterViewTarget =>
    global::Assimalign.Viu.DynamicComponents.Named("RouterView");

public object TransitionTarget =>
    global::Assimalign.Viu.DynamicComponents.Named("SynchronousTransition");

partial void OnSetup() =>
    Router = Context!.Services?.GetService(typeof(ViuRouter)) as ViuRouter
        ?? throw new InvalidOperationException("RouterOutletShell requires Router services.");
}
