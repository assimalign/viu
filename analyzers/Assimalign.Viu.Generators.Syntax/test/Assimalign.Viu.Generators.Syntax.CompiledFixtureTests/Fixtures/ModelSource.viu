<template><a @click="Raise">update models</a></template>

@script {
    using Assimalign.Viu.Components;
    [Parameter] public int ModelValue { get; set; }
    [Parameter] public bool Enabled { get; set; }
    [Parameter] public string Text { get; set; } = string.Empty;
    [Parameter] public string? NullableText { get; set; }
    [Event("update:modelValue")] public partial void UpdateModelValue(int value);
    [Event("update:enabled")] public partial void UpdateEnabled(bool value);
    [Event("update:text")] public partial void UpdateText(string value);
    [Event("update:nullableText")] public partial void UpdateNullableText(string? value);
    private void Raise() { UpdateModelValue(17); UpdateEnabled(false); UpdateText("component"); UpdateNullableText(null); }
}
