<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLibraries)</TargetFramework>
    <IsPackable>false</IsPackable>
    <ViuUseSingleFileComponents>true</ViuUseSingleFileComponents>
    <ViuUseFileRouting>true</ViuUseFileRouting>
    <!-- This DOM-free test host has no static web asset pipeline or component styles. -->
    <ViuBundleSingleFileComponentCss>false</ViuBundleSingleFileComponentCss>
  </PropertyGroup>
  <ItemGroup>
    <ViuPackageReference Include="Microsoft.NET.Test.Sdk" />
    <ViuPackageReference Include="xunit" />
    <ViuPackageReference Include="xunit.runner.visualstudio" />
    <ViuPackageReference Include="Shouldly" />
  </ItemGroup>
  <ItemGroup>
    <ViuProjectReference Include="Assimalign.Viu.Components" />
    <ViuProjectReference Include="Assimalign.Viu.FileRouting" />
    <ViuProjectReference Include="Assimalign.Viu.Router" />
    <ViuProjectReference Include="Assimalign.Viu.Testing" />
  </ItemGroup>
  <ItemGroup>
    <ViuAnalyzerReference Include="Assimalign.Viu.Generators.Syntax" />
    <ViuAnalyzerReference Include="Assimalign.Viu.Generators.FileRouting" />
  </ItemGroup>
</Project>
