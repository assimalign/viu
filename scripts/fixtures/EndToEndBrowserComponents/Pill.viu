<!-- A small status label. Shows declared parameters with defaults and a computed class. -->
<template>
    <span :class="CssClass">{{ Label }}</span>
</template>

@script {
    using Assimalign.Viu.Components;

    /// <summary>Gets or sets the text shown inside the pill.</summary>
    [Parameter(IsRequired = true)]
    public string Label { get; set; } = string.Empty;

    /// <summary>Gets or sets the color tone: neutral, success, warning, or accent.</summary>
    [Parameter]
    public string Tone { get; set; } = "neutral";

    public string CssClass => $"pill pill--{Tone}";
}

<style>
    .pill {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.6rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--viu-text-muted, #475569);
        background: var(--viu-surface-muted, #f1f5f9);
    }

    .pill--success {
        color: #047857;
        background: #d1fae5;
    }

    .pill--warning {
        color: #b45309;
        background: #fef3c7;
    }

    .pill--accent {
        color: var(--viu-accent, #4f46e5);
        background: color-mix(in srgb, var(--viu-accent, #4f46e5) 12%, transparent);
    }
</style>
