<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLibraries)</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- This staging-only suite hosts Roslyn, emits a transient assembly, and reflects over the
         generated component types. It is test infrastructure rather than a shipping AOT surface. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ViuPackageReference Include="Microsoft.NET.Test.Sdk" />
    <ViuPackageReference Include="xunit" />
    <ViuPackageReference Include="xunit.runner.visualstudio" />
    <ViuPackageReference Include="Shouldly" />
    <ViuPackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ViuProjectReference Include="Assimalign.Viu.Browser" />
    <ViuProjectReference Include="Assimalign.Viu.Components" />
    <ViuProjectReference Include="Assimalign.Viu.Core" />
    <ViuProjectReference Include="Assimalign.Viu.Reactivity" />
  </ItemGroup>
  <ItemGroup>
    <!-- Deviates from the repo central project-reference rule per the staging design decision:
         this isolated proof must execute the production generator outside .redesign while the
         fail-closed redesign resolver intentionally rejects every external by-name reference.
         TODO(swap): replace this edge with ViuPrivateProjectReference after the tree swap. -->
    <ProjectReference Include="..\..\..\..\analyzers\Assimalign.Viu.Generators.Syntax\src\Assimalign.Viu.Generators.Syntax.csproj"
                      PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Fixtures\**\*.viu;Fixtures\**\*.vue"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
