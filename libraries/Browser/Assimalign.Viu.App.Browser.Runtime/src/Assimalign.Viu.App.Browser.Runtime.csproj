<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="$(ViuRepositoryDirectory)libraries\Runtime\Assimalign.Viu.App.Pack.props" />
    <PropertyGroup>
        <RootNamespace>Assimalign.Viu.Browser</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId Condition="'$(RuntimeIdentifier)' != ''">Assimalign.Viu.App.Browser.Runtime.$(RuntimeIdentifier)</PackageId>
        <PackageId Condition="'$(RuntimeIdentifier)' == ''">Assimalign.Viu.App.Browser.Runtime</PackageId>
        <IsPackable>true</IsPackable>
        <NoWarn>$(NoWarn);NU5128;NU5100;NU5131;CS2008</NoWarn>
        <ViuFrameworkName>Assimalign.Viu.App.Browser</ViuFrameworkName>
        <ViuFrameworkKind>Runtime</ViuFrameworkKind>
    </PropertyGroup>

    <Import Project="$(ViuRepositoryDirectory)libraries\Browser\Assimalign.Viu.App.Browser.props" />
    <Import Project="$(ViuRepositoryDirectory)libraries\Runtime\Assimalign.Viu.App.targets" />
</Project>
