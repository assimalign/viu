<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLibraries)</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- This test project deliberately drives the source generator and Roslyn (CSharpCompilation.Emit +
         Assembly.Load) so a generated component can be MOUNTED and observed, not just read as text. Those
         are AOT/trim-unfriendly by nature, so opt this test-only project out of the libraries/ AOT
         default — it is not a shipping library. Mirrors Assimalign.Viu.Browser.CompiledRenderTests.
         It is a separate project from Assimalign.Viu.Testing.Tests because the generator's transitive
         Assimalign.Viu.Syntax.Templates reference collides with Assimalign.Viu.Shared on the linked
         PatchFlags shared source that those tests name directly. -->
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ViuPackageReference Include="Microsoft.NET.Test.Sdk" />
    <ViuPackageReference Include="xunit" />
    <ViuPackageReference Include="xunit.runner.visualstudio" />
    <ViuPackageReference Include="Shouldly" />
    <!-- Compiles the generator-emitted component scaffold in-process so it can be mounted for real. -->
    <ViuPackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- The DOM-free host the compiled component is mounted in, plus the runtime surfaces the generated
         scaffold binds against by name. -->
    <ViuProjectReference Include="Assimalign.Viu.Testing" />
    <ViuProjectReference Include="Assimalign.Viu.Core" />
    <ViuProjectReference Include="Assimalign.Viu.Reactivity" />
    <!-- The generator appears ONLY in this test project, never in runtime code. A private compile
         reference so the test can instantiate and drive it; its transitive .viu-parser references copy
         into the test bin so the composed parser runs in-process. -->
    <ViuPrivateProjectReference Include="Assimalign.Viu.Generators.Syntax" />
  </ItemGroup>
</Project>
