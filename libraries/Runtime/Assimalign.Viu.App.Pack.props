<Project>
    <!-- Deviates from the repo central-build-system file-location rule per owner decision
         2026-10-22 (#381): framework-specific build files live beside their pack producers. -->

    <!--
        Framework Ref/Runtime pack producers ([V01.01.12.19], #174).

        TargetFramework and the one canonical package version come from the
        central build aliases. Framework producers only select their container
        shape and exact dependency policy here.
    -->
    <PropertyGroup>
        <TargetFramework>$(TargetFrameworkForFrameworks)</TargetFramework>
        <!-- NuGet only invokes its symbol collection graph when IncludeBuildOutput=true. Runtime
             packs keep it and the owning targets remove the empty producer assembly; Ref packs
             override it to false because they deliberately publish no symbol package. -->
        <ViuContainerPackage>true</ViuContainerPackage>
        <IsAotCompatible>false</IsAotCompatible>
        <ViuPackageReadmeSource>$(ViuRepositoryDirectory)README.md</ViuPackageReadmeSource>
        <IncludeBuildOutput>true</IncludeBuildOutput>
        <!-- Shared-framework manifests and copied assets form one lockstep release. -->
        <ViuPackageDependencyVersionRange>[$(ViuVersion)]</ViuPackageDependencyVersionRange>
    </PropertyGroup>
</Project>
