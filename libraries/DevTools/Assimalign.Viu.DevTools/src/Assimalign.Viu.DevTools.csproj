<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLibraries)</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Required by the browser-only postMessage [JSImport]/[JSExport] bridge. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <ViuProjectReference Include="Assimalign.Viu.Components" />
    <ViuProjectReference Include="Assimalign.Viu.Core" />
    <ViuProjectReference Include="Assimalign.Viu.Reactivity" />
  </ItemGroup>
  <ItemGroup>
    <None Update="wwwroot\viu-devtools.js"
          Pack="true"
          PackagePath="assets\Assimalign.Viu.DevTools\viu-devtools.js"
          Visible="false" />
    <None Include="$(ViuRepositoryDirectory)build\Targets\Build.DevTools.targets"
          Pack="true"
          PackagePath="buildTransitive\Assimalign.Viu.DevTools.targets"
          Visible="false" />
    <None Include="..\docs\PROTOCOL.md"
          Pack="true"
          PackagePath="docs\PROTOCOL.md"
          Visible="false" />
  </ItemGroup>
</Project>
