<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Assimalign.Viu.Browser</RootNamespace>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <PackageId>Assimalign.Viu.App.Browser.Ref</PackageId>
        <IsPackable>true</IsPackable>
        <NoWarn>$(NoWarn);NU5128;NU5100;NU5131;CS2008</NoWarn>
        <ViuFrameworkName>Assimalign.Viu.App.Browser</ViuFrameworkName>
        <ViuFrameworkKind>Ref</ViuFrameworkKind>
    </PropertyGroup>

    <Import Project="..\..\Assimalign.Viu.App.Browser.props" />
    <ItemGroup>
        <ViuProjectReference Include="@(ViuFrameworkAssembly)" />
    </ItemGroup>
    <Import Project="..\..\Assimalign.Viu.App.targets" />
</Project>
