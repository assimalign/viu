<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This shared compiler base carries the primitives (Position,
         SourceLocation, SyntaxList, SyntaxNode, Diagnostic) the template compiler ([V01.01.05.05])
         and single-file-component ([V01.01.06.02]) generators consume INSIDE their netstandard2.0 Roslyn
         analyzer hosts. It therefore targets the analyzer TFM alias — the same central property the
         derived parsers and the generators projects use — never a hardcoded string. Its net10.0 test
         project references it normally. -->
    <TargetFramework>$(TargetFrameworkForAnalyzers)</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- IsAotCompatible is intentionally not set here: tooling projects do not inherit the runtime-library
         default, and the AOT analyzers require net7.0+. This assembly is consumed at build time by the
         generators, not shipped into the WASM
         app, so AOT-compat analysis does not apply; the runtime AOT boundary is enforced on the
         generators' OUTPUT, which is ordinary net10.0 code. -->
  </PropertyGroup>
</Project>
