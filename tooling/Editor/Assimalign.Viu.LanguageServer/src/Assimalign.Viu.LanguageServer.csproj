<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(TargetFrameworkForLanguageServers)</TargetFramework>
    <AssemblyName>Assimalign.Viu.LanguageServer</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Keep trimming project-local. Passing PublishTrimmed as a global publish property would
         incorrectly propagate it to the netstandard2.0 syntax project references. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Roslyn ships 13 localization satellite pairs; this server never surfaces localized Roslyn
         diagnostics, and without this the single-file bundle grows by several MB per runtime
         identifier. Project-local for the same reason as the trim settings above. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- IL2104 is the per-assembly rollup for trim warnings inside Microsoft.CodeAnalysis[.CSharp]
         ([V01.01.12.07.04], #261). TrimMode=partial roots those assemblies whole (they declare no
         IsTrimmable), so every member their reflection could reach is kept and the rollup is noise
         for this publish. Scoped to this csproj — the only trimmed project in the repository. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ViuProjectReference Include="Assimalign.Viu.LanguageService" />
  </ItemGroup>
</Project>
