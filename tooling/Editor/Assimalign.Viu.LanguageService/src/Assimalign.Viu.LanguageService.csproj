<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForLanguageServers)</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ViuProjectReference Include="Assimalign.Viu.Syntax.SingleFileComponent" />
    <!-- The shared .viu -> C# projection library ([V01.01.06.11], #258): declared @script member
         description (ScriptBlockAnalyzer.DescribeMembers) and the block-to-file position composition
         (SingleFileComponentDiagnostics.ComposeToFilePosition) are the same code the build's source
         generator runs, so editor results and build results agree by construction. -->
    <ViuProjectReference Include="Assimalign.Viu.Compiler.SingleFileComponent" />
    <!-- StyleScopeId feeds the semantic engine's projection inputs ([V01.01.12.23], #259) with the
         exact scope id the build's source generator derives, so the editor-built generated document
         is identical to the generator's by construction. -->
    <ViuProjectReference Include="Assimalign.Viu.Compiler.Css" />
    <!-- Component style-class completion ([V01.01.12.07.13], #334) reads selectors from the same
         recoverable CSS tree the compiler scopes and emits. Already in the closure transitively;
         declared here because this project now compiles directly against its syntax types. -->
    <ViuProjectReference Include="Assimalign.Viu.Syntax.Css" />
    <!-- Template element folding ([V01.01.12.07.07]) parses the template block's markup with the same
         recoverable template parser the build compiles templates with, so the elements the editor folds
         are exactly the elements the build sees. Already in the closure transitively; declared here
         because this project now compiles against it. -->
    <ViuProjectReference Include="Assimalign.Viu.Syntax.Templates" />
    <!-- The shared projection library runs a syntax-only Roslyn parse (no compilation, no workspace,
         no MSBuild) at service runtime ([V01.01.12.07.04], #261). Runtime assets must flow to the
         Assimalign.Viu.LanguageServer publish, so no PrivateAssets here. -->
    <ViuPackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
</Project>
