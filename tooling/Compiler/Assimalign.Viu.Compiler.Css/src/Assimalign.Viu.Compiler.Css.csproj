<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This shared build-time CSS composition core ([V01.01.12.12]) runs
         in TWO build-time hosts that are both netstandard2.0 — the Assimalign.Viu.Generators.Syntax Roslyn
         source generator (analyzer sandbox) AND the ViuBundleCss MSBuild task — so it targets the analyzer
         TFM alias, the same central property the Assimalign.Viu.Syntax.* parsers use, never a hardcoded
         string. Its net10.0 test project references it normally. -->
    <TargetFramework>$(TargetFrameworkForAnalyzers)</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- IsAotCompatible is intentionally not set: tooling projects do not inherit the runtime-library
         default, and the AOT analyzers require net8.0+. This assembly is consumed at build time by the
         generator and the bundling task, never shipped into the
         WASM app; the runtime AOT boundary is enforced on the generator's OUTPUT, which is ordinary net10.0
         code. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- The composition-root libraries this shared core reuses: the .viu block parser
         ([V01.01.06.02]), the template parser it dispatches ([V01.01.05.05]), and the CSS AST + scoped /
         module / v-bind rewriters ([V01.01.06.04]/[V01.01.06.06]). Like the generator, this compiler core is
         the one place these language libraries meet — they never reference each other. -->
    <ViuProjectReference Include="Assimalign.Viu.Syntax" />
    <ViuProjectReference Include="Assimalign.Viu.Syntax.SingleFileComponent" />
    <ViuProjectReference Include="Assimalign.Viu.Syntax.Templates" />
    <ViuProjectReference Include="Assimalign.Viu.Syntax.Css" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked netstandard2.0 shims ([V01.01.05.09]): IsExternalInit and the required-member attributes
         are authored once in Assimalign.Viu.Syntax and <Compile Include>'d here (still internal) because an
         internal shim in a referenced assembly is not visible to this compilation — each netstandard2.0
         assembly needs its own copy to light up `init`/`record`/`required`. -->
    <Compile Include="$(ViuRepositoryDirectory)libraries\Syntax\Assimalign.Viu.Syntax\src\Shims\IsExternalInit.cs" Link="Shims\IsExternalInit.cs" />
    <Compile Include="$(ViuRepositoryDirectory)libraries\Syntax\Assimalign.Viu.Syntax\src\Shims\RequiredMemberShims.cs" Link="Shims\RequiredMemberShims.cs" />
  </ItemGroup>
</Project>
