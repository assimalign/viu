{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assimalign.github.io/viu/schemas/utility-css-compatibility-manifest.json",
  "title": "Viu Utilities compatibility manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "compatibilityVersion",
    "officialReferences",
    "utilityRoots",
    "documentedUtilityFamilies",
    "variants",
    "themeNamespaces",
    "directives",
    "functions",
    "sourceForms",
    "promisedModes",
    "goldenVectorFile",
    "knownIntegrationGaps"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "compatibilityVersion": { "const": "4.3.3" },
    "utilityRoots": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "documentedUtilityFamilies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [ "name", "roots", "modes", "officialReference", "sourceReference" ],
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "roots": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "modes": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "officialReference": {
              "type": "string",
              "pattern": "^https://tailwindcss\\.com/docs/[a-z0-9-]+$"
            },
            "sourceReference": {
              "const": "https://github.com/tailwindlabs/tailwindcss/blob/v4.3.3/packages/tailwindcss/src/utilities.ts"
            }
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [ "root", "kind", "category" ]
      }
    },
    "knownIntegrationGaps": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
