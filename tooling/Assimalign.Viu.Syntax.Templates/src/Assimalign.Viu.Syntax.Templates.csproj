<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The template compiler front end runs INSIDE the Roslyn
         codegen generator ([V01.01.05.05]), which is a netstandard2.0 analyzer host. It therefore targets
         the analyzer TFM alias — the same central property the generators project uses — never a hardcoded
         string. Its net10.0 test project references it normally. -->
    <TargetFramework>$(TargetFrameworkForAnalyzers)</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- IsAotCompatible is intentionally not set: tooling projects do not inherit the runtime-library
         default, and the AOT analyzers require net7.0+. This library is consumed at build time by the
         generator, not shipped
         into the WASM app, so AOT-compat analysis does not apply; the runtime AOT boundary is enforced on
         the generator's OUTPUT, which is ordinary net10.0 code. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- The shared base ([V01.01.05.09]): Position, SourceLocation, SyntaxList, SyntaxNode, and the
         Diagnostic surface live in Assimalign.Viu.Syntax; TemplateSyntaxNode and CompilerError
         derive from them. -->
    <ViuProjectReference Include="Assimalign.Viu.Syntax" />
  </ItemGroup>
  <ItemGroup>
    <!-- Roslyn expression parsing ([V01.01.05.04]): template expressions are C#, so the C# parser is what
         parses, validates, and rewrites them in the netstandard2.0 compiler front end. The compiler's idea
         of an expression is therefore exactly the C# compiler's, with no second grammar to keep in sync.
         The version is centralized in build/Targets/Build.References.Packages.targets
         (never inline here). This is a generator-only dependency by graph position, not by
         PrivateAssets: the library sits build-time-only in the dependency graph (consumed by the codegen
         generator [V01.01.05.05], whose Roslyn is provided by the compiler host), so Microsoft.CodeAnalysis
         never reaches the WASM runtime — nothing mechanical enforces that, and the analyzer packaging chain
         ([V01.01.05.05]) is where the guarantee gets pinned. The reference flows normally so this library's
         net10.0 test project resolves Roslyn at run time. -->
    <ViuPackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked netstandard2.0 shims ([V01.01.05.09]): IsExternalInit and the required-member attributes
         are authored once in Assimalign.Viu.Syntax and <Compile Include>'d here (still internal) because
         an internal shim in a referenced assembly is not visible to this compilation — each netstandard2.0
         assembly needs its own copy to light up `init`/`record`/`required`. -->
    <Compile Include="..\..\Assimalign.Viu.Syntax\src\Shims\IsExternalInit.cs" Link="Shims\IsExternalInit.cs" />
    <Compile Include="..\..\Assimalign.Viu.Syntax\src\Shims\RequiredMemberShims.cs" Link="Shims\RequiredMemberShims.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Linked shared-source seam ([V01.01.01.03]): the single authoritative DOM knowledge data is authored
         in Assimalign.Viu.Shared against the netstandard2.0 lowest common denominator precisely so the
         template compiler can <Compile Include> it here without a net10.0 project reference (Shared is
         net10.0 and cannot be referenced from netstandard2.0). See the file header and the
         Assimalign.Viu.Shared.GeneratorFixture precedent. -->
    <Compile Include="..\..\..\libraries\Assimalign.Viu.Shared\src\Internal\DomKnowledgeData.cs" Link="Internal\DomKnowledgeData.cs" />
    <!-- Linked staged-source seam ([SFC-CG-7]): PatchFlags and SlotFlags are the compiler <-> runtime
         contracts owned by Assimalign.Viu.Components. Components targets net10.0 and cannot be referenced
         from this netstandard2.0 analyzer-host project, so the two enum source files are <Compile Include>'d
         here. Both remain netstandard2.0-clean and keep one authoritative definition instead of a drifting
         compiler mirror. The compiler assembly is build-time-only and is never loaded beside Components at
         runtime; generated consumer code names the Components identities from the adopted runtime assembly. -->
    <!-- TODO(swap): Flip this staged Components path to libraries/ when the adopted tree swaps. -->
    <Compile Include="..\..\..\.redesign\libraries\Assimalign.Viu.Components\src\PatchFlags.cs" Link="Components\PatchFlags.cs" />
    <!-- TODO(swap): Flip this staged Components path to libraries/ when the adopted tree swaps. -->
    <Compile Include="..\..\..\.redesign\libraries\Assimalign.Viu.Components\src\SlotFlags.cs" Link="Components\SlotFlags.cs" />
  </ItemGroup>
</Project>
