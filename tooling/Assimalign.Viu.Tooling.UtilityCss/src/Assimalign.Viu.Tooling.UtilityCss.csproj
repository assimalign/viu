<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Deviates from the repo build-system rule (shipping libraries use
         $(TargetFrameworkForLibraries) = net10.0) per the [V01.01.12.13] design decision:
         candidate parsing is shared build-time tooling loaded by both Roslyn analyzer hosts and
         the CSS-generating MSBuild task. It therefore targets the central analyzer TFM alias,
         never a hardcoded framework, exactly like Assimalign.Viu.Tooling.Css. The net10.0 test
         project references it normally. -->
    <TargetFramework>$(TargetFrameworkForAnalyzers)</TargetFramework>
    <!-- IsAotCompatible is intentionally not set: its analyzers require net8.0 or later. This
         assembly runs only at build/editor time and emits no runtime code. Its implementation
         remains reflection-free, deterministic, and I/O-free. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- netstandard2.0 needs its own internal record/init shims. These linked paths are the
         repository's frozen shared-source locations. -->
    <Compile Include="..\..\..\libraries\Assimalign.Viu.Syntax\src\Shims\IsExternalInit.cs" Link="Shims\IsExternalInit.cs" />
    <Compile Include="..\..\..\libraries\Assimalign.Viu.Syntax\src\Shims\RequiredMemberShims.cs" Link="Shims\RequiredMemberShims.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The independently transformed v4.3.3 compatibility data carries the upstream MIT notice
         into the library package and every SDK/editor host that copies this build-time assembly. -->
    <None Include="..\docs\THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="THIRD-PARTY-NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          TargetPath="Assimalign.Viu.Tooling.UtilityCss.THIRD-PARTY-NOTICES.md" />
  </ItemGroup>
</Project>
