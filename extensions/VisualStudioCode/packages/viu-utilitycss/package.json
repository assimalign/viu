{
  "name": "viu-utilitycss",
  "displayName": "Viu Utilities",
  "description": "Utility CSS completion, hover previews, and color tools for HTML-based files.",
  "version": "0.1.0",
  "publisher": "assimalign",
  "license": "MIT",
  "icon": "assets/branding/viu-nuget-mono-light-256.png",
  "preview": true,
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/assimalign/viu.git",
    "directory": "extensions/VisualStudioCode/packages/viu-utilitycss"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "viu",
    "utility css",
    "css",
    "html",
    "razor",
    "intellisense"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:cshtml",
    "onLanguage:razor",
    "onLanguage:aspnetcorerazor",
    "onLanguage:vue",
    "onLanguage:viu"
  ],
  "contributes": {
    "configuration": {
      "title": "Viu Utilities",
      "properties": {
        "viuUtilityCss.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start the Viu Utilities language server for supported HTML-based documents."
        },
        "viuUtilityCss.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Absolute path to a Viu Utility CSS language-server executable. Overrides the payload bundled with this extension; intended for developing the server itself."
        },
        "viuUtilityCss.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the Language Server Protocol traffic between Visual Studio Code and the Viu Utilities language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "check": "tsc --noEmit -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "^5.4.0"
  }
}
