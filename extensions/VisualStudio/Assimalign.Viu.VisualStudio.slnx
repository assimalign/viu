<Solution>
  <Folder Name="/Visual Studio/">
    <File Path="README.md" />
    <File Path="Build.ps1" />
  </Folder>
  <!-- The language service and server are developer tooling and live under the repository's
       tooling/ root; this solution still carries them because they are built, debugged, and
       deployed together with the Visual Studio host. -->
  <Folder Name="/Visual Studio/Language Service/">
    <Project Path="../../tooling/Assimalign.Viu.Tooling.LanguageService/src/Assimalign.Viu.Tooling.LanguageService.csproj" />
    <Project Path="../../tooling/Assimalign.Viu.Tooling.LanguageService/test/Assimalign.Viu.Tooling.LanguageService.Tests.csproj" />
  </Folder>
  <Folder Name="/Visual Studio/Language Server/">
    <Project Path="../../tooling/Assimalign.Viu.Tooling.LanguageServer/src/Assimalign.Viu.Tooling.LanguageServer.csproj" />
    <Project Path="../../tooling/Assimalign.Viu.Tooling.LanguageServer/test/Assimalign.Viu.Tooling.LanguageServer.Tests.csproj" />
  </Folder>
  <Folder Name="/Visual Studio/Extension/">
    <Project Path="Assimalign.Viu.VisualStudio/src/Assimalign.Viu.VisualStudio.csproj">
      <Deploy />
    </Project>
    <Project Path="Assimalign.Viu.VisualStudio/test/Assimalign.Viu.VisualStudio.Tests.csproj" />
  </Folder>
</Solution>
