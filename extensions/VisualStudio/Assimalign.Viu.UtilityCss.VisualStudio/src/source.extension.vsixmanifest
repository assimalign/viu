<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
                 xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Assimalign.Viu.UtilityCss.VisualStudio.8fcd5c9a-f62f-467c-8655-b7791c41775b"
              Version="|Assimalign.Viu.UtilityCss.VisualStudio;GetVsixVersion|"
              Language="en-US"
              Publisher="Assimalign" />
    <DisplayName>Viu Utilities for Visual Studio</DisplayName>
    <Description xml:space="preserve">Utility CSS completion, generated-CSS hover previews, and document colors for HTML files, served by an isolated Viu Utilities language-server process.</Description>
    <MoreInfo>https://github.com/assimalign/viu</MoreInfo>
    <Preview>true</Preview>
  </Metadata>
  <Installation>
    <!-- Both Windows payloads ship in one package; the client selects the host architecture. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  Version="[17.14,19.0)"
                  DisplayName="Visual Studio core editor" />
    <Prerequisite Id="Microsoft.VisualStudio.ComponentGroup.WebToolsExtensions"
                  Version="[17.14,19.0)"
                  DisplayName="ASP.NET and web development" />
  </Prerequisites>
  <Assets>
    <!-- The only in-process asset is the standard ILanguageClient MEF export. There is deliberately
         no VsPackage/pkgdef asset because this extension claims no file extension or registry key. -->
    <Asset Type="Microsoft.VisualStudio.MefComponent"
           d:Source="Project"
           d:ProjectName="%CurrentProject%"
           Path="|%CurrentProject%|" />
  </Assets>
</PackageManifest>
