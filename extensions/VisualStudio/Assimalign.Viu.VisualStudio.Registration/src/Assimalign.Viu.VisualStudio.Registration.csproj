<!--
  The companion registration VSIX. Its only payload is a .pkgdef claiming the .viu file extension
  for the Source Code (Text) Editor.

  Why a second package instead of an asset on Assimalign.Viu.VisualStudio: a .pkgdef asset requires
  VssdkCompatibleExtension, which in turn mandates RequiresInProcessHosting. Carrying the pkgdef on
  the main extension would drag it in process and forfeit the out-of-process isolation that is the
  recorded architecture decision. A classic VSSDK package has no such constraint, and one that
  contains no code costs nothing to host.

  The Sdk attribute is spelled out as explicit Sdk.props/Sdk.targets imports because
  Microsoft.VsSDK.targets must be imported AFTER the .NET SDK's own targets, which the attribute
  form makes impossible. Microsoft.VSSDK.BuildTools contributes only $(VSToolsPath) through its
  NuGet props; the VSIX packaging targets themselves are imported by hand, exactly as the classic
  VSIX project template does.

  This project is deliberately absent from BOTH Assimalign.Viu.slnx and
  Assimalign.Viu.VisualStudio.slnx: the VSSDK build tasks are .NET Framework MSBuild tasks that
  cannot load under `dotnet build`, and both solutions are gated by dotnet (`dotnet build` for the
  repository solution, `dotnet test` for the Visual Studio one in area-visual-studio.yml). Build it
  with extensions\VisualStudio\Build.Registration.ps1, which locates MSBuild through vswhere.
-->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForVisualStudioClassicExtensions)</TargetFramework>
    <!-- The repository default emits [assembly: RequiresPreviewFeatures], whose attribute does not
         exist on the .NET Framework surface every classic VSIX compiles against. -->
    <EnablePreviewFeatures>false</EnablePreviewFeatures>
    <IsPackable>false</IsPackable>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Produce the .vsix, but never deploy to an experimental hive from a command-line build. -->
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <!-- The pkgdef is authored by hand, not generated from ProvideX registration attributes: there
         is no VSPackage class here to attribute. -->
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <!-- Keep the package to exactly one meaningful file. The C# compiler still emits an empty
         assembly; none of it reaches the .vsix. -->
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeCopyLocalReferencesInVSIXContainer>false</IncludeCopyLocalReferencesInVSIXContainer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Version and asset flags come from build\Targets\Build.References.Packages.targets. -->
    <ViuPackageReference Include="Microsoft.VSSDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both files are already in the SDK's default None glob; they are removed and re-declared so
         the VSSDK metadata is explicit rather than layered onto an implicit item. -->
    <None Remove="source.extension.vsixmanifest" />
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <!-- The whole payload. GetVsixSourceItems honours IncludeInVSIX only on Content items. -->
    <None Remove="Assimalign.Viu.VisualStudio.Registration.pkgdef" />
    <Content Include="Assimalign.Viu.VisualStudio.Registration.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Resolves the |Assimalign.Viu.VisualStudio.Registration;GetVsixVersion| token in
    source.extension.vsixmanifest. The VSSDK has no built-in version token: the bare
    |ProjectName| form substitutes the built assembly's file name, not a version. Returning
    VersionPrefix keeps the VSIX version on the ordinary .NET version properties, so
    Build.Registration.ps1 -Version reaches the manifest the same way Build.ps1 -Version reaches
    the main extension's.
  -->
  <Target Name="GetVsixVersion" Returns="$(_ViuRegistrationVsixVersion)">
    <PropertyGroup>
      <_ViuRegistrationVsixVersion>$(VersionPrefix)</_ViuRegistrationVsixVersion>
    </PropertyGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
