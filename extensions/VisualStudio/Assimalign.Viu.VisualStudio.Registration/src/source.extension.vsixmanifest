<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0"
                 xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011"
                 xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
  <Metadata>
    <Identity Id="Assimalign.Viu.VisualStudio.Registration.64c9ad4a-df23-463f-b3ca-0d651fc02338"
              Version="|Assimalign.Viu.VisualStudio.Registration;GetVsixVersion|"
              Language="en-US"
              Publisher="Assimalign" />
    <DisplayName>Viu File Association for Visual Studio</DisplayName>
    <Description xml:space="preserve">Registers the .viu file extension with the Visual Studio Source Code (Text) Editor so Viu single-file components are no longer claimed by the XML editor's wildcard factory. Install alongside "Viu for Visual Studio".</Description>
    <MoreInfo>https://github.com/assimalign/viu</MoreInfo>
    <Preview>true</Preview>
  </Metadata>
  <Installation>
    <!-- Visual Studio 2022 17.14 (the VisualStudio.Extensibility line the main extension targets)
         through the Visual Studio 2026 (18.x) band, on both supported host architectures. -->
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Pro" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
    <InstallationTarget Id="Microsoft.VisualStudio.Enterprise" Version="[17.14,19.0)">
      <ProductArchitecture>arm64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <!-- The core editor is the only thing this package needs: it registers an editor-factory file
       extension and ships no code. -->
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor"
                  Version="[17.14,19.0)"
                  DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <!-- The entire payload. A .pkgdef is the only durable way to claim a file extension for an
         editor factory, and an out-of-process VisualStudio.Extensibility extension cannot ship
         one, so this companion package carries it and nothing else. -->
    <Asset Type="Microsoft.VisualStudio.VsPackage"
           d:Source="File"
           Path="Assimalign.Viu.VisualStudio.Registration.pkgdef" />
  </Assets>
</PackageManifest>
