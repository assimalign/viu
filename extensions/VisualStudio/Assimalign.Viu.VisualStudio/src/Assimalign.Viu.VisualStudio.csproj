<!--
  The Viu Visual Studio extension: a classic, in-process VSSDK package.

  Why in process. The editor surface Viu needs - a content type it owns, its own classification
  types, and the format definitions that give them colors and bold - exists only as MEF exports
  inside devenv.exe. The out-of-process VisualStudio.Extensibility model this project used before
  has no equivalent: it can only borrow the editor's built-in categories, so a Viu palette was
  impossible there, and its remote tag bridge rejected names as ordinary as Roslyn's `method`.
  Nothing semantic moved in process with this change: the language server remains a separate stdio
  executable (tooling\Assimalign.Viu.LanguageServer), so Roslyn and the Viu parsers still
  never load into devenv.exe. See docs\DESIGN.md.

  The Sdk attribute is spelled out as explicit Sdk.props/Sdk.targets imports because
  Microsoft.VsSDK.targets must be imported AFTER the .NET SDK's own targets, which the attribute
  form makes impossible. Microsoft.VSSDK.BuildTools contributes only $(VSToolsPath) through its
  NuGet props; the VSIX packaging targets themselves are imported by hand, exactly as the classic
  VSIX project template does.

  This project is deliberately absent from Assimalign.Viu.slnx: the VSSDK build tasks are .NET
  Framework MSBuild tasks that cannot load under `dotnet build`, which gates that solution. It stays
  in Assimalign.Viu.VisualStudio.slnx for Visual Studio work and is built by
  extensions\VisualStudio\Build.ps1, which locates Visual Studio's MSBuild through vswhere. Its test
  project cannot reference it either, and compiles the editor-free sources through <Compile Include>
  links instead - see test\Assimalign.Viu.VisualStudio.Tests.csproj.
-->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <TargetFramework>$(TargetFrameworkForVisualStudioClassicExtensions)</TargetFramework>
    <IsPackable>false</IsPackable>
    <NeutralLanguage>en-US</NeutralLanguage>

    <!-- Opts into build\Targets\Build.LanguageServer.targets: the single source of truth that
         publishes, packages, and validates the standalone server payload. The publish arguments
         deliberately do not live here, so pressing F5 and running Build.ps1 cannot drift apart.
         Before that target existed this project only asserted the payload was present and shipped
         whatever happened to be on disk, which silently redeployed a months-old language server. -->
    <ViuLanguageServerPublishEnabled>true</ViuLanguageServerPublishEnabled>

    <!-- The payload is produced by a target, so the design-time build cannot see it and Visual
         Studio's fast up-to-date check has no reliable view of this project's real inputs. Packaging
         the extension already costs tens of seconds; skipping MSBuild is not a saving worth a stale
         language server. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Produce the .vsix. DeployExtension is split by host: building inside Visual Studio keeps
         the classic development loop - every Debug build refreshes the experimental hive and F5
         launches it - while command-line builds (Build.ps1, CI) never write into a hive as a side
         effect of compiling; their supported loop is explicit: build, then install the packaged
         VSIX. A command-line build can still opt in per invocation with -p:DeployExtension=true. -->
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension Condition="'$(BuildingInsideVisualStudio)' != 'true'">false</DeployExtension>
    <!-- The pkgdef is authored by hand, not generated from ProvideX registration attributes: the
         extension contributes MEF parts and a file-extension claim, and has no VSPackage class to
         attribute. -->
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <!-- Visual Studio supplies every assembly this extension compiles against, so nothing copy-local
         belongs in the container. The package's own payload is its MEF assembly, the pkgdef,
         language-server.json, and the two language-server executables. -->
    <IncludeCopyLocalReferencesInVSIXContainer>false</IncludeCopyLocalReferencesInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions and asset flags come from build\Targets\Build.References.Packages.targets. The
         editor packages are compile-only: Visual Studio owns the implementations at run time. -->
    <ViuPackageReference Include="Microsoft.VSSDK.BuildTools" />
    <ViuPackageReference Include="Microsoft.VisualStudio.CoreUtility" />
    <ViuPackageReference Include="Microsoft.VisualStudio.Text.Data" />
    <ViuPackageReference Include="Microsoft.VisualStudio.Text.Logic" />
    <ViuPackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" />
    <ViuPackageReference Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" />
    <!-- The classic in-process language-server client API (ILanguageClient, Connection) and the
         threading primitives its events are typed with. -->
    <ViuPackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" />
    <ViuPackageReference Include="Microsoft.VisualStudio.Threading" />
    <!-- Transitive dependencies of the client package pinned to silence NU1603, exactly as
         Imaging.Interop is above. -->
    <ViuPackageReference Include="Microsoft.VisualStudio.Telemetry" />
    <ViuPackageReference Include="Microsoft.VisualStudio.Utilities" />
    <ViuPackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup>
    <!-- MEF composition and the WPF types the classification format definitions are built from.
         UseWPF is a .NET Core-and-later switch, so on the .NET Framework line the two presentation
         assemblies are referenced directly. -->
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <!-- ViuLexicalSpan is a record struct, and the .NET Framework does not ship IsExternalInit. This
         is the repository's single authoritative copy of the shim, linked (still internal) exactly
         as the netstandard2.0 parser projects link it; its path is frozen. -->
    <Compile Include="$(ViuRepositoryDirectory)tooling\Assimalign.Viu.Syntax\src\Shims\IsExternalInit.cs"
             Link="Shims\IsExternalInit.cs" />
    <!-- The WHATWG void-element table ViuAutoClosingLogic excludes from element auto-close, taken
         from the repository's single authoritative DOM knowledge definition rather than retyped for
         the editor. It is written to the lowest-common-denominator language surface precisely so
         hosts like this one can link it; its path is frozen. -->
    <Compile Include="$(ViuRepositoryDirectory)libraries\Assimalign.Viu.ServerRenderer\src\Internal\DomKnowledgeData.cs"
             Link="Internal\DomKnowledgeData.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both files are already in the SDK's default None glob; they are removed and re-declared so
         the VSSDK metadata is explicit rather than layered onto an implicit item. -->
    <None Remove="source.extension.vsixmanifest" />
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <!-- GetVsixSourceItems honours IncludeInVSIX only on Content items. -->
    <None Remove="Assimalign.Viu.VisualStudio.pkgdef" />
    <Content Include="Assimalign.Viu.VisualStudio.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="language-server.json">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Resolves the |Assimalign.Viu.VisualStudio;GetVsixVersion| token in source.extension.vsixmanifest.
    The VSSDK has no built-in version token: the bare |ProjectName| form substitutes the built
    assembly's file name, not a version. Returning VersionPrefix keeps the VSIX version on the
    ordinary .NET version properties, so Build.ps1 -Version reaches the manifest through the same
    central versioning every other Viu artifact uses.
  -->
  <Target Name="GetVsixVersion" Returns="$(_ViuExtensionVsixVersion)">
    <PropertyGroup>
      <_ViuExtensionVsixVersion>$(VersionPrefix)</_ViuExtensionVsixVersion>
    </PropertyGroup>
  </Target>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
