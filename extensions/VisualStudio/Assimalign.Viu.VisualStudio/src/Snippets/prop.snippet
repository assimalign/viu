<?xml version="1.0" encoding="utf-8"?>
<!--
  The auto-implemented property shortcut.

  Shipped as a Visual Studio code snippet rather than as a completion item because the behaviour an
  author expects from `prop` is a snippet SESSION: Tab expands it, Tab moves between the type and the
  name, and the last Tab or Enter commits. A completion item can only write text; the session is what
  supplies the fields, and this editor does not expand Language Server Protocol placeholders either.

  Adding another shortcut is this file plus one entry in ViuSnippetShortcut - no other code changes.
-->
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>prop</Title>
      <Shortcut>prop</Shortcut>
      <Description>Code snippet for an automatically implemented property</Description>
      <Author>Assimalign</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>type</ID>
          <ToolTip>Property type</ToolTip>
          <Default>int</Default>
        </Literal>
        <Literal>
          <ID>property</ID>
          <ToolTip>Property name</ToolTip>
          <Default>MyProperty</Default>
        </Literal>
      </Declarations>
      <Code Language="viu"><![CDATA[public $type$ $property$ { get; set; }$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
