<Project Sdk="Assimalign.Viu.Sdk.Browser">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>ViuApplication</RootNamespace>
    <AssemblyName>ViuApplication</AssemblyName>
    <IsPackable>false</IsPackable>
    <DefaultItemExcludes>$(DefaultItemExcludes);Components\**;Server\**</DefaultItemExcludes>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!--#if (nullable) -->
    <Nullable>enable</Nullable>
    <!--#else -->
    <Nullable>disable</Nullable>
    <!--#endif -->
  </PropertyGroup>
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS"
                                      Pattern="*.js"
                                      Expression="#[.{fingerprint}]!" />
  </ItemGroup>
  <!--#if (ssr) -->
  <ItemGroup>
    <ProjectReference Include="Components\__VIU_PROJECT_FILE_NAME__.Components.csproj" />
  </ItemGroup>
  <!--#endif -->
</Project>
