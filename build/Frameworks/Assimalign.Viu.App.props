<Project>
    <!--
        Host-neutral targeting-framework manifest ([V01.01.12.27], #323).

        Assimalign.Viu.App is deliberately targeting-only: component libraries
        compile against these four assemblies and receive the generator closure,
        but do not restore or publish a Viu runtime pack. The Browser framework
        imports this file to reuse the runtime assembly inventory while keeping
        its own targeting pack limited to the Browser assembly.
    -->
    <ItemGroup>
        <ViuBaseFrameworkAssembly Include="Assimalign.Viu.Reactivity" />
        <ViuBaseFrameworkAssembly Include="Assimalign.Viu.Components" />
        <ViuBaseFrameworkAssembly Include="Assimalign.Viu.State" />
        <ViuBaseFrameworkAssembly Include="Assimalign.Viu.Core" />

        <ViuBaseFrameworkPackageOverride Include="Assimalign.Viu.Reactivity" />
        <ViuBaseFrameworkPackageOverride Include="Assimalign.Viu.Components" />
        <ViuBaseFrameworkPackageOverride Include="Assimalign.Viu.State" />
        <ViuBaseFrameworkPackageOverride Include="Assimalign.Viu.Core" />

        <ViuBaseFrameworkAnalyzer Include="Assimalign.Viu.Generators.Reactivity" />
        <ViuBaseFrameworkAnalyzer Include="Assimalign.Viu.Generators.Syntax" />
    </ItemGroup>

    <ItemGroup Condition="'$(ViuFrameworkName)' == 'Assimalign.Viu.App'">
        <ViuFrameworkAssembly Include="@(ViuBaseFrameworkAssembly)" />
        <ViuFrameworkPackageOverride Include="@(ViuBaseFrameworkPackageOverride)" />
        <ViuFrameworkAnalyzer Include="@(ViuBaseFrameworkAnalyzer)" />
    </ItemGroup>
</Project>
