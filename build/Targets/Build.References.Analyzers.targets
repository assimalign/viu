<Project>
    <!-- Analyzer Reference By Name Only

        ViuAnalyzerReference       - ROSLYN ANALYZER / SOURCE GENERATOR
                                            reference. Resolves against
                                            analyzers/**/*.csproj. Emits a
                                            <ProjectReference> with
                                            OutputItemType="Analyzer" +
                                            ReferenceOutputAssembly="false" so
                                            the analyzer activates at compile
                                            time (dogfood); AND adds the built
                                            analyzer DLL to the consuming
                                            library's nupkg under
                                            analyzers/dotnet/cs/ so external
                                            consumers pick it up automatically
                                            via <PackageReference>.
    -->
    <ItemGroup>
        <!-- Index analyzer projects ONCE. -->
        <_ViuAnalyzerProject Include="$(ViuRepositoryDirectory)analyzers\**\*.csproj" />
        <_ViuAnalyzerProject Update="@(_ViuAnalyzerProject)" ProjectId="%(_ViuAnalyzerProject.Filename)" ProjectPath="%(_ViuAnalyzerProject.Identity)" />

        <!--
            Analyzer refs. OutputItemType=Analyzer + ReferenceOutputAssembly=false
            tells the .NET SDK to load the project's output as a Roslyn analyzer
            (instead of a normal assembly reference) when the consumer builds.
            PrivateAssets=all keeps the analyzer csproj from leaking as a NuGet
            dependency of the consuming library.
        -->
        <ViuAnalyzerReference Update="@(_ViuAnalyzerProject->'%(ProjectId)')" ProjectPath="%(_ViuAnalyzerProject.ProjectPath)" />
        <ProjectReference Include="@(ViuAnalyzerReference->'%(ProjectPath)')"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />

        <!--
            Capture the resolved analyzer csproj paths for the pack hook below.
            We can't reuse @(ViuAnalyzerReference) directly because it gets
            consumed (Remove'd) immediately so MSBuild's incremental graph
            cleanup is happy.
        -->
        <_ViuAnalyzerResolved Include="@(ViuAnalyzerReference->'%(ProjectPath)')" />
        <ViuAnalyzerReference Remove="@(ViuAnalyzerReference->HasMetadata('ProjectPath'))" />

        <_ViuAnalyzerProject Remove="@(_ViuAnalyzerProject)" />
    </ItemGroup>

    <!--
        Pack each referenced analyzer DLL into the consuming library's nupkg at
        analyzers/dotnet/cs/<Name>.dll. NuGet's built-in analyzer convention
        picks them up automatically on every consumer that adds a
        <PackageReference> to the library, so no extra wiring is needed on the
        consumer side.

        We hook TargetsForTfmSpecificContentInPackage (same extension point the
        SDK pack uses) and look up each analyzer's GetTargetPath at pack time -
        that yields the actual DLL path including the analyzer's own TFM
        (netstandard2.0), without us having to hardcode it.
    -->
    <!--
        Top-level PropertyGroup Conditions can't reference @(items) (MSB4099),
        so extend the hook unconditionally; the target's own Condition gates
        execution to projects that actually declared an analyzer reference.
    -->
    <PropertyGroup>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_CollectViuAnalyzersForPack</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <Target Name="_CollectViuAnalyzersForPack"
            Condition="'@(_ViuAnalyzerResolved)' != ''">
        <MSBuild Projects="@(_ViuAnalyzerResolved)"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="OutDir;OutputPath;IntermediateOutputPath;TargetFramework;TargetFrameworks;RuntimeIdentifier">
            <Output TaskParameter="TargetOutputs" ItemName="_ViuAnalyzerDll" />
        </MSBuild>
        <ItemGroup>
            <TfmSpecificPackageFile Include="@(_ViuAnalyzerDll)">
                <PackagePath>analyzers/dotnet/cs</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>

        <!--
            An analyzer ships ONLY its DLL from here. Consumer-facing MSBuild logic never lives in a
            per-project build/ folder next to an analyzer's src/: every .props/.targets belongs either
            to sdks/Assimalign.Viu.Sdk/Targets/ (consumer-facing Viu MSBuild experience) or to the
            repository-root build/ folder (this repo's own pipeline). The .viu AdditionalFiles wiring
            that used to sit in analyzers/Assimalign.Viu.Generators.Syntax/build/ is now
            sdks/Assimalign.Viu.Sdk/Targets/Assimalign.Viu.Generators.Syntax.props|.targets, delivered
            to packaged consumers by the SDK package and imported in-repo at the bottom of this file.
        -->
    </Target>
    <!--
        A generator consumed by ProjectReference (OutputItemType=Analyzer) surfaces only its own DLL to
        the consumer's compiler, but Roslyn resolves a generator's dependencies exclusively among the
        registered analyzer paths - so a generator with project-reference dependencies must append those
        outputs to its own GetTargetPath result for every consumer to load the full closure. Analyzer
        csprojs opt in with <ViuAnalyzerBundlesProjectReferenceOutputs>true</...>.
    -->
    <PropertyGroup Condition="'$(ViuAnalyzerBundlesProjectReferenceOutputs)' == 'true'">
        <GetTargetPathDependsOn>$(GetTargetPathDependsOn);_ViuAppendAnalyzerProjectReferenceOutputs</GetTargetPathDependsOn>
    </PropertyGroup>
    <Target Name="_ViuAppendAnalyzerProjectReferenceOutputs"
            Condition="'$(ViuAnalyzerBundlesProjectReferenceOutputs)' == 'true'"
            DependsOnTargets="ResolveProjectReferences">
        <ItemGroup>
            <TargetPathWithTargetPlatformMoniker Include="@(_ResolvedProjectReferencePaths)" IncludeRuntimeDependency="false" />
        </ItemGroup>
    </Target>

    <!--
        In-repo dogfooding seam for the .viu generator. Its MSBuild wiring (the **/*.viu
        AdditionalFiles glob and CompilerVisibleProperty declarations) lives in
        sdks/Assimalign.Viu.Sdk/Targets/ - the single authoritative copy. Packaged consumers get it
        because Sdk.props/Sdk.targets import it out of the SDK package's Targets/ folder; in-repo
        projects get it from the same files through the imports below.

        A ViuAnalyzerReference alone cannot infer the wiring - imports evaluate before items exist -
        so it is opted into with a property instead: set <ViuUseSingleFileComponents>true</...>
        alongside the analyzer reference.
    -->
    <Import Project="$(ViuRepositoryDirectory)sdks\Assimalign.Viu.Sdk\Targets\Assimalign.Viu.Generators.Syntax.props"
            Condition="'$(ViuUseSingleFileComponents)' == 'true' and Exists('$(ViuRepositoryDirectory)sdks\Assimalign.Viu.Sdk\Targets\Assimalign.Viu.Generators.Syntax.props')" />
    <Import Project="$(ViuRepositoryDirectory)sdks\Assimalign.Viu.Sdk\Targets\Assimalign.Viu.Generators.Syntax.targets"
            Condition="'$(ViuUseSingleFileComponents)' == 'true' and Exists('$(ViuRepositoryDirectory)sdks\Assimalign.Viu.Sdk\Targets\Assimalign.Viu.Generators.Syntax.targets')" />
</Project>
