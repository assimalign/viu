<Project>
  <!--
    Standalone Viu Utilities build pipeline ([V01.01.12.16], #159; hot development input graph
    [V01.01.12.05.01], #248).

    This target intentionally does not depend on $(ViuBundleSingleFileComponentCss): utility
    generation and component style-block bundling are separate features and produce separate assets.
    MSBuild owns source discovery; ViuBundleUtilityCss owns template slicing, plain-text candidate
    scanning, deterministic compilation, content comparison, and stale-output deletion.
  -->

  <PropertyGroup>
    <!-- The packaged Viu SDK enables utilities by default. In-repo projects remain opt-in unless
         they are using that SDK, preventing build-time tooling/library projects from recursively
         loading the SDK task while it is being built. -->
    <ViuBundleUtilityCss Condition="'$(ViuBundleUtilityCss)' == '' and '$(_ViuSdk)' == 'true'">true</ViuBundleUtilityCss>
    <ViuBundleUtilityCss Condition="'$(ViuBundleUtilityCss)' == ''">false</ViuBundleUtilityCss>

    <!-- Automatic project-root discovery can be disabled while retaining explicitly supplied
         @(ViuUtilityCssSource) items. The patterns intentionally omit C# and CSS. -->
    <ViuUtilityCssAutomaticSourceDiscovery Condition="'$(ViuUtilityCssAutomaticSourceDiscovery)' == ''">true</ViuUtilityCssAutomaticSourceDiscovery>
    <ViuUtilityCssSourcePatterns Condition="'$(ViuUtilityCssSourcePatterns)' == ''">**/*.viu;**/*.vue;**/*.html;**/*.htm</ViuUtilityCssSourcePatterns>

    <!-- The task ships beside ViuBundleCss. Packaged consumers receive the preconfigured path from
         Assimalign.Viu.Sdk.Browser.Common.props; in-repo opt-in consumers use the loose SDK layout. -->
    <ViuUtilityCssTaskAssembly Condition="'$(ViuUtilityCssTaskAssembly)' == ''">$(ViuOutputPathForSdk)\$(NETCoreSdkVersion)\sdks\Assimalign.Viu.Sdk.Browser\Tasks\Assimalign.Viu.Sdk.Browser.Tasks.dll</ViuUtilityCssTaskAssembly>

    <ViuInjectUtilityCssLink Condition="'$(ViuInjectUtilityCssLink)' == '' and '$(ViuBundleUtilityCss)' == 'true'">true</ViuInjectUtilityCssLink>
    <ViuInjectUtilityCssLink Condition="'$(ViuInjectUtilityCssLink)' == ''">false</ViuInjectUtilityCssLink>
  </PropertyGroup>

  <ItemGroup Condition="'$(ViuBundleUtilityCss)' == 'true'">
    <!-- The CSS-first configuration root is explicit and singular. It is configuration input, not
         an automatically scanned candidate source, preserving the no-CSS-source-detection rule. -->
    <_ViuUtilityCssResolvedEntry Include="@(ViuUtilityCss)" KeepDuplicates="false" />

    <!-- Preserve whether each source was explicit: CSS-first source(none) and source(<path>)
         replace automatic discovery while retaining project-authored @(ViuUtilityCssSource) items. -->
    <_ViuUtilityCssSourceCandidate Include="@(ViuUtilityCssSource)">
      <ViuUtilityCssDiscovery>Explicit</ViuUtilityCssDiscovery>
    </_ViuUtilityCssSourceCandidate>
    <_ViuUtilityCssSourceCandidate
      Include="$(ViuUtilityCssSourcePatterns)"
      Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)"
      Condition="'$(ViuUtilityCssAutomaticSourceDiscovery)' == 'true'">
      <ViuUtilityCssDiscovery>Automatic</ViuUtilityCssDiscovery>
    </_ViuUtilityCssSourceCandidate>
    <_ViuUtilityCssSourceCandidate Remove="@(ViuUtilityCssSourceExclude)" />
    <_ViuUtilityCssResolvedSource Include="@(_ViuUtilityCssSourceCandidate)" KeepDuplicates="false" />
  </ItemGroup>

  <UsingTask TaskName="Assimalign.Viu.Sdk.Browser.Tasks.ViuBundleUtilityCss"
             AssemblyFile="$(ViuUtilityCssTaskAssembly)"
             Condition="'$(ViuBundleUtilityCss)' == 'true'" />
  <UsingTask TaskName="Assimalign.Viu.Sdk.Browser.Tasks.ViuInjectCssBundleLink"
             AssemblyFile="$(ViuUtilityCssTaskAssembly)"
             Condition="'$(ViuInjectUtilityCssLink)' == 'true'" />

  <!--
    In-repo build-order edge. This is the same narrow, documented deviation used by
    Build.Css.Bundling.targets: UsingTask is not a project dependency, and ViuProjectReference
    cannot express ReferenceOutputAssembly=false plus UndefineProperties across the app TFM/RID
    boundary. When component CSS is also enabled, its identical edge already supplies the order.
  -->
  <ItemGroup Condition="'$(ViuBundleUtilityCss)' == 'true' and '$(ViuBundleSingleFileComponentCss)' != 'true' and '$(ViuRepositoryDirectory)' != '' and Exists('$(ViuRepositoryDirectory)sdks\Assimalign.Viu.Sdk.Browser\Tasks\Assimalign.Viu.Sdk.Browser.Tasks.csproj')">
    <ProjectReference Include="$(ViuRepositoryDirectory)sdks\Assimalign.Viu.Sdk.Browser\Tasks\Assimalign.Viu.Sdk.Browser.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      PrivateAssets="all"
                      UndefineProperties="TargetFramework;RuntimeIdentifier" />
  </ItemGroup>

  <!-- dotnet watch calls this hook after its own item graph exists. Source add/change/delete events
       therefore re-run the utility target without linking a watcher into the published application. -->
  <PropertyGroup Condition="'$(ViuBundleUtilityCss)' == 'true'">
    <CustomCollectWatchItems>$(CustomCollectWatchItems);_ViuCollectUtilityCssWatchItems</CustomCollectWatchItems>
  </PropertyGroup>

  <Target Name="_ViuCollectUtilityCssWatchItems"
          Condition="'$(ViuBundleUtilityCss)' == 'true'">
    <ItemGroup>
      <Watch Include="%(_ViuUtilityCssResolvedSource.FullPath)"
             Condition="'%(_ViuUtilityCssResolvedSource.Watch)' != 'false'"
             KeepDuplicates="false" />
      <Watch Include="%(_ViuUtilityCssResolvedEntry.FullPath)"
             Condition="'%(_ViuUtilityCssResolvedEntry.Watch)' != 'false'"
             KeepDuplicates="false" />
    </ItemGroup>
  </Target>

  <Target Name="_ViuResolveUtilityCssConfiguration"
          Condition="'$(ViuBundleUtilityCss)' == 'true'"
          DependsOnTargets="ResolveStaticWebAssetsConfiguration">
    <PropertyGroup>
      <ViuUtilityCssBundleBaseName Condition="'$(ViuUtilityCssBundleBaseName)' == ''">$(PackageId)</ViuUtilityCssBundleBaseName>
      <ViuUtilityCssBundleExtension Condition="'$(ViuUtilityCssBundleExtension)' == ''">.utilities.css</ViuUtilityCssBundleExtension>
      <ViuUtilityCssBundleName Condition="'$(ViuUtilityCssBundleName)' == ''">$(ViuUtilityCssBundleBaseName)$(ViuUtilityCssBundleExtension)</ViuUtilityCssBundleName>
      <ViuUtilityCssBundleFingerprintExpression Condition="'$(ViuUtilityCssBundleFingerprintExpression)' == ''">$(ViuUtilityCssBundleBaseName)#[.{fingerprint}]?$(ViuUtilityCssBundleExtension)</ViuUtilityCssBundleFingerprintExpression>
      <_ViuUtilityCssBundleContentRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)viu\'))</_ViuUtilityCssBundleContentRoot>
      <_ViuUtilityCssBundlePath>$(_ViuUtilityCssBundleContentRoot)$(ViuUtilityCssBundleName)</_ViuUtilityCssBundlePath>
      <_ViuUtilityCssHotReloadEmptyBundleMarkerPath>$(_ViuUtilityCssBundlePath).hot-reload-empty</_ViuUtilityCssHotReloadEmptyBundleMarkerPath>
      <_ViuUtilityCssHotReloadDependencyManifestPath>$(_ViuUtilityCssBundlePath).hot-reload-dependencies</_ViuUtilityCssHotReloadDependencyManifestPath>
      <_ViuPreserveUtilityCssHotReloadEmptyBundle>false</_ViuPreserveUtilityCssHotReloadEmptyBundle>
      <_ViuPreserveUtilityCssHotReloadEmptyBundle Condition="'$(ViuCssHotReloadWorker)' == 'true'">true</_ViuPreserveUtilityCssHotReloadEmptyBundle>
      <_ViuPreserveUtilityCssHotReloadEmptyBundle Condition="'$(ViuCssHotReloadEnabled)' == 'true' and '$(DotNetWatchBuild)' == 'true'">true</_ViuPreserveUtilityCssHotReloadEmptyBundle>
      <!-- Preserve availability when the Inputs/Outputs target is skipped as current. -->
      <_ViuUtilityCssBundleExists Condition="Exists('$(_ViuUtilityCssBundlePath)')">true</_ViuUtilityCssBundleExists>
      <_ViuUtilityCssBundleExists Condition="!Exists('$(_ViuUtilityCssBundlePath)')">false</_ViuUtilityCssBundleExists>
    </PropertyGroup>
  </Target>

  <!-- dotnet watch needs one final static-file update when the last utility disappears. The worker
       retains a marked zero-byte bundle for that update; every normal build and publish removes it
       before incremental evaluation so no development tombstone can ship. -->
  <Target Name="_ViuRemoveUtilityCssHotReloadTombstone"
          Condition="'$(ViuBundleUtilityCss)' == 'true' and '$(ViuCssHotReloadWorker)' != 'true' and Exists('$(_ViuUtilityCssHotReloadEmptyBundleMarkerPath)')"
          DependsOnTargets="_ViuResolveUtilityCssConfiguration">
    <Delete Files="$(_ViuUtilityCssBundlePath);$(_ViuUtilityCssHotReloadEmptyBundleMarkerPath)" />
    <PropertyGroup>
      <_ViuUtilityCssBundleExists>false</_ViuUtilityCssBundleExists>
    </PropertyGroup>
  </Target>

  <!-- Always invoke the deterministic task: MSBuild timestamp inputs cannot observe removal of one
       file while older sources remain. The task compares final bytes and skips unchanged writes, so
       ordinary no-op builds retain the bundle timestamp while partial deletions cannot leave stale
       utility rules behind. -->
  <Target Name="_ViuBundleUtilityCss"
          Condition="'$(ViuBundleUtilityCss)' == 'true' and Exists('$(ViuUtilityCssTaskAssembly)')"
          DependsOnTargets="_ViuResolveUtilityCssConfiguration;_ViuRemoveUtilityCssHotReloadTombstone">
    <ViuBundleUtilityCss SourceFiles="@(_ViuUtilityCssResolvedSource)"
                         UtilityStylesheets="@(_ViuUtilityCssResolvedEntry)"
                         ProjectDirectory="$(MSBuildProjectDirectory)"
                         BundleOutputPath="$(_ViuUtilityCssBundlePath)"
                         PreserveEmptyBundleOnRemoval="$(_ViuPreserveUtilityCssHotReloadEmptyBundle)"
                         EmptyBundleMarkerPath="$(_ViuUtilityCssHotReloadEmptyBundleMarkerPath)"
                         HotReloadDependencyManifestPath="$(_ViuUtilityCssHotReloadDependencyManifestPath)">
      <Output TaskParameter="BundlePath" PropertyName="_ViuUtilityCssBundleWrittenPath" />
      <Output TaskParameter="BundleWritten" PropertyName="_ViuUtilityCssBundleWasWritten" />
      <Output TaskParameter="BundleExists" PropertyName="_ViuUtilityCssBundleExists" />
    </ViuBundleUtilityCss>
    <ItemGroup>
      <FileWrites Include="$(_ViuUtilityCssBundlePath)"
                  Condition="'$(_ViuUtilityCssBundleExists)' == 'true' and Exists('$(_ViuUtilityCssBundlePath)')" />
    </ItemGroup>
  </Target>

  <!-- Register the independent utility bundle through the same content-hashed static-web-asset
       primitives as component CSS. The optional fingerprint retains a stable physical route for
       static WASM hosting while adding a content-derived endpoint for manifest-aware hosts. -->
  <Target Name="ResolveViuUtilityCssAssets"
          Condition="'$(ViuBundleUtilityCss)' == 'true' and Exists('$(ViuUtilityCssTaskAssembly)')"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          DependsOnTargets="_ViuBundleUtilityCss">
    <ItemGroup Condition="'$(_ViuUtilityCssBundleExists)' == 'true' and Exists('$(_ViuUtilityCssBundlePath)')">
      <_ViuUtilityCssStaticWebAssetCandidate Include="$(_ViuUtilityCssBundlePath)">
        <RelativePath Condition="'$(StaticWebAssetFingerprintingEnabled)' == 'true'">$(ViuUtilityCssBundleFingerprintExpression)</RelativePath>
        <RelativePath Condition="'$(StaticWebAssetFingerprintingEnabled)' != 'true'">$(ViuUtilityCssBundleName)</RelativePath>
      </_ViuUtilityCssStaticWebAssetCandidate>
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_ViuUtilityCssStaticWebAssetCandidate)' != ''"
                           CandidateAssets="@(_ViuUtilityCssStaticWebAssetCandidate)"
                           SourceType="Computed"
                           SourceId="$(PackageId)"
                           ContentRoot="$(_ViuUtilityCssBundleContentRoot)"
                           BasePath="$(StaticWebAssetBasePath)"
                           AssetKind="All"
                           AssetMode="CurrentProject"
                           AssetRole="Primary"
                           CopyToOutputDirectory="Never"
                           CopyToPublishDirectory="PreserveNewest">
      <Output TaskParameter="Assets" ItemName="_ViuUtilityCssStaticWebAsset" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_ViuUtilityCssStaticWebAsset)' != ''"
                                   CandidateAssets="@(_ViuUtilityCssStaticWebAsset)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_ViuUtilityCssStaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <ItemGroup>
      <StaticWebAsset Include="@(_ViuUtilityCssStaticWebAsset)" />
      <StaticWebAssetEndpoint Include="@(_ViuUtilityCssStaticWebAssetEndpoint)" />
    </ItemGroup>
  </Target>

  <!--
    Compression-safe host-page injection. When component CSS injection is active, utility injection
    explicitly follows it and transforms its already re-registered host-page copy; otherwise it
    follows the WebAssembly SDK's placeholder rewrite directly. In either case this is the last
    content transform before compressed assets are resolved, so integrity and compressed variants
    are computed from the page containing every generated stylesheet link.
  -->
  <Target Name="_ViuResolveUtilityCssLinkConfiguration"
          Condition="'$(ViuInjectUtilityCssLink)' == 'true'"
          DependsOnTargets="_ViuResolveUtilityCssConfiguration">
    <PropertyGroup>
      <ViuUtilityCssBundleLinkHref Condition="'$(ViuUtilityCssBundleLinkHref)' == ''">$(ViuUtilityCssBundleName)</ViuUtilityCssBundleLinkHref>
      <_ViuUtilityCssLinkBuildContentRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)viu\utilityhtmllink\build\'))</_ViuUtilityCssLinkBuildContentRoot>
      <_ViuUtilityCssLinkPublishContentRoot>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)viu\utilityhtmllink\publish\'))</_ViuUtilityCssLinkPublishContentRoot>
      <_ViuUtilityCssLinkBuildRewriteDependency Condition="'$(ViuInjectSingleFileComponentCssLink)' == 'true'">_ViuInjectSingleFileComponentCssLinkBuild</_ViuUtilityCssLinkBuildRewriteDependency>
      <_ViuUtilityCssLinkPublishRewriteDependency Condition="'$(ViuInjectSingleFileComponentCssLink)' == 'true'">_ViuInjectSingleFileComponentCssLinkPublish</_ViuUtilityCssLinkPublishRewriteDependency>
      <_ViuUtilityCssLinkBuildRewriteDependency Condition="'$(_ViuUtilityCssLinkBuildRewriteDependency)' == '' and '$(OverrideHtmlAssetPlaceholders)' == 'true'">ResolveHtmlAssetPlaceholdersBuildStaticWebAssets</_ViuUtilityCssLinkBuildRewriteDependency>
      <_ViuUtilityCssLinkPublishRewriteDependency Condition="'$(_ViuUtilityCssLinkPublishRewriteDependency)' == '' and '$(OverrideHtmlAssetPlaceholders)' == 'true'">ResolveHtmlAssetPlaceholdersPublishStaticWebAssets</_ViuUtilityCssLinkPublishRewriteDependency>
    </PropertyGroup>
  </Target>

  <Target Name="_ViuInjectUtilityCssLinkBuild"
          Condition="'$(ViuInjectUtilityCssLink)' == 'true' and Exists('$(ViuUtilityCssTaskAssembly)')"
          BeforeTargets="ResolveBuildCompressedStaticWebAssetsConfiguration"
          DependsOnTargets="_ViuResolveUtilityCssLinkConfiguration;$(_ViuUtilityCssLinkBuildRewriteDependency)">
    <ItemGroup Condition="'$(_ViuUtilityCssBundleExists)' == 'true' and Exists('$(_ViuUtilityCssBundlePath)')">
      <_ViuUtilityCssLinkHostPageBuild Include="@(StaticWebAsset)"
                                       Condition="'%(Extension)' == '.html' and '%(AssetKind)' != 'Publish'" />
    </ItemGroup>

    <ViuInjectCssBundleLink Condition="'@(_ViuUtilityCssLinkHostPageBuild)' != ''"
                            HostPagePath="%(_ViuUtilityCssLinkHostPageBuild.FullPath)"
                            OutputPath="$(_ViuUtilityCssLinkBuildContentRoot)%(_ViuUtilityCssLinkHostPageBuild.FileName)%(_ViuUtilityCssLinkHostPageBuild.Extension)"
                            LinkHref="$(ViuUtilityCssBundleLinkHref)"
                            BundleFileName="$(ViuUtilityCssBundleName)" />

    <ItemGroup Condition="'@(_ViuUtilityCssLinkHostPageBuild)' != ''">
      <_ViuUtilityCssLinkUpdatedHostPageBuildCandidate
        Include="@(_ViuUtilityCssLinkHostPageBuild->'$(_ViuUtilityCssLinkBuildContentRoot)%(FileName)%(Extension)')"
        RemoveMetadata="SourceType;AssetKind;Integrity;Fingerprint" />
      <_ViuUtilityCssLinkUpdatedHostPageBuildCandidate
        ContentRoot="$(_ViuUtilityCssLinkBuildContentRoot)"
        OriginalItemSpec="%(_ViuUtilityCssLinkUpdatedHostPageBuildCandidate.Identity)" />
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_ViuUtilityCssLinkUpdatedHostPageBuildCandidate)' != ''"
                           CandidateAssets="@(_ViuUtilityCssLinkUpdatedHostPageBuildCandidate)"
                           SourceType="Computed"
                           AssetKind="Build">
      <Output TaskParameter="Assets" ItemName="_ViuUtilityCssLinkUpdatedHostPageBuild" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_ViuUtilityCssLinkUpdatedHostPageBuild)' != ''"
                                   CandidateAssets="@(_ViuUtilityCssLinkUpdatedHostPageBuild)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_ViuUtilityCssLinkUpdatedHostPageBuildEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <FilterStaticWebAssetEndpoints Condition="'@(_ViuUtilityCssLinkHostPageBuild)' != ''"
                                   Endpoints="@(StaticWebAssetEndpoint)"
                                   Assets="@(_ViuUtilityCssLinkHostPageBuild)"
                                   Filters="">
      <Output TaskParameter="FilteredEndpoints" ItemName="_ViuUtilityCssLinkOldHostPageBuildEndpoint" />
    </FilterStaticWebAssetEndpoints>

    <ItemGroup Condition="'@(_ViuUtilityCssLinkUpdatedHostPageBuild)' != ''">
      <StaticWebAsset Remove="@(_ViuUtilityCssLinkHostPageBuild)" />
      <StaticWebAsset Include="@(_ViuUtilityCssLinkUpdatedHostPageBuild)" />
      <StaticWebAssetEndpoint Remove="@(_ViuUtilityCssLinkOldHostPageBuildEndpoint)" />
      <StaticWebAssetEndpoint Include="@(_ViuUtilityCssLinkUpdatedHostPageBuildEndpoint)" />
    </ItemGroup>
  </Target>

  <Target Name="_ViuInjectUtilityCssLinkPublish"
          Condition="'$(ViuInjectUtilityCssLink)' == 'true' and Exists('$(ViuUtilityCssTaskAssembly)')"
          BeforeTargets="ResolvePublishCompressedStaticWebAssetsConfiguration"
          DependsOnTargets="_ViuResolveUtilityCssLinkConfiguration;$(_ViuUtilityCssLinkPublishRewriteDependency)">
    <ItemGroup Condition="'$(_ViuUtilityCssBundleExists)' == 'true' and Exists('$(_ViuUtilityCssBundlePath)')">
      <_ViuUtilityCssLinkHostPagePublish Include="@(StaticWebAsset)"
                                         Condition="'%(Extension)' == '.html' and '%(AssetKind)' != 'Build'" />
    </ItemGroup>

    <ViuInjectCssBundleLink Condition="'@(_ViuUtilityCssLinkHostPagePublish)' != ''"
                            HostPagePath="%(_ViuUtilityCssLinkHostPagePublish.FullPath)"
                            OutputPath="$(_ViuUtilityCssLinkPublishContentRoot)%(_ViuUtilityCssLinkHostPagePublish.FileName)%(_ViuUtilityCssLinkHostPagePublish.Extension)"
                            LinkHref="$(ViuUtilityCssBundleLinkHref)"
                            BundleFileName="$(ViuUtilityCssBundleName)" />

    <ItemGroup Condition="'@(_ViuUtilityCssLinkHostPagePublish)' != ''">
      <_ViuUtilityCssLinkUpdatedHostPagePublishCandidate
        Include="@(_ViuUtilityCssLinkHostPagePublish->'$(_ViuUtilityCssLinkPublishContentRoot)%(FileName)%(Extension)')"
        RemoveMetadata="SourceType;AssetKind;Integrity;Fingerprint" />
      <_ViuUtilityCssLinkUpdatedHostPagePublishCandidate
        ContentRoot="$(_ViuUtilityCssLinkPublishContentRoot)"
        OriginalItemSpec="%(_ViuUtilityCssLinkUpdatedHostPagePublishCandidate.Identity)" />
    </ItemGroup>

    <DefineStaticWebAssets Condition="'@(_ViuUtilityCssLinkUpdatedHostPagePublishCandidate)' != ''"
                           CandidateAssets="@(_ViuUtilityCssLinkUpdatedHostPagePublishCandidate)"
                           SourceType="Computed"
                           AssetKind="Publish">
      <Output TaskParameter="Assets" ItemName="_ViuUtilityCssLinkUpdatedHostPagePublish" />
    </DefineStaticWebAssets>

    <DefineStaticWebAssetEndpoints Condition="'@(_ViuUtilityCssLinkUpdatedHostPagePublish)' != ''"
                                   CandidateAssets="@(_ViuUtilityCssLinkUpdatedHostPagePublish)"
                                   ExistingEndpoints="@(StaticWebAssetEndpoint)"
                                   ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="_ViuUtilityCssLinkUpdatedHostPagePublishEndpoint" />
    </DefineStaticWebAssetEndpoints>

    <FilterStaticWebAssetEndpoints Condition="'@(_ViuUtilityCssLinkHostPagePublish)' != ''"
                                   Endpoints="@(StaticWebAssetEndpoint)"
                                   Assets="@(_ViuUtilityCssLinkHostPagePublish)"
                                   Filters="">
      <Output TaskParameter="FilteredEndpoints" ItemName="_ViuUtilityCssLinkOldHostPagePublishEndpoint" />
    </FilterStaticWebAssetEndpoints>

    <ItemGroup Condition="'@(_ViuUtilityCssLinkUpdatedHostPagePublish)' != ''">
      <StaticWebAsset Remove="@(_ViuUtilityCssLinkHostPagePublish)" />
      <StaticWebAsset Include="@(_ViuUtilityCssLinkUpdatedHostPagePublish)" />
      <StaticWebAssetEndpoint Remove="@(_ViuUtilityCssLinkOldHostPagePublishEndpoint)" />
      <StaticWebAssetEndpoint Include="@(_ViuUtilityCssLinkUpdatedHostPagePublishEndpoint)" />
    </ItemGroup>
  </Target>
</Project>
