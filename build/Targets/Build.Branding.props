<Project>
    <PropertyGroup>
        <Company>Assimalign</Company>
        <Copyright>© Assimalign 2025</Copyright>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/assimalign/viu</RepositoryUrl>
        <PackageProjectUrl>https://github.com/assimalign/viu</PackageProjectUrl>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageIcon>viu-nuget-dark-128.png</PackageIcon>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Authors>Assimalign</Authors>
        <Description>$(MSBuildProjectName) is part of Viu, a C#/.NET UI framework for WebAssembly.</Description>
        <!--
            The Vue tag is nuget.org discoverability for the .vue single-file-component
            compatibility feature ([V01.01.06.09]), not a statement about Viu's semantics.
            Whether to keep it is a product decision; see docs/SPECIFICATION.md §9.
        -->
        <PackageTags>Viu;Vue;WebAssembly;WASM;dotnet</PackageTags>

        <!--
            The package icon is an imported branding artifact. Keep its repository location
            separate from PackageIcon, which is the path NuGet records inside the archive.
        -->
        <ViuPackageIconSource>$(ViuRepositoryDirectory)assets\branding\nuget\$(PackageIcon)</ViuPackageIconSource>

        <!--
            .NET 10 carries the Git providers and SourceLink tasks in the SDK, so no external
            SourceLink package is required. Keep the contract explicit here: every build is
            deterministic, repository metadata is published into the nuspec, and untracked
            generated sources are embedded in the portable PDB rather than becoming unverifiable
            local-file references ([V01.01.12.03]). CI additionally sets
            ContinuousIntegrationBuild, either through GitHub's CI environment variable or the
            release packer's explicit property.
        -->
        <Deterministic>true</Deterministic>
        <DebugType>portable</DebugType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == '' and '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>
</Project>
