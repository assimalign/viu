<Project>
    <PropertyGroup>
        <Company>Assimalign</Company>
        <Copyright>© Assimalign 2025</Copyright>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/assimalign/viu</RepositoryUrl>
        <PackageProjectUrl>https://github.com/assimalign/viu</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <Authors>Assimalign</Authors>
        <Description>$(MSBuildProjectName) is part of Viu, a C#/.NET UI framework for WebAssembly.</Description>
        <!--
            The Vue tag is nuget.org discoverability for the .vue single-file-component
            compatibility feature ([V01.01.06.09]), not a statement about Viu's semantics.
            Whether to keep it is a product decision; see docs/SPECIFICATION.md §9.
        -->
        <PackageTags>Viu;Vue;WebAssembly;WASM;dotnet</PackageTags>
    </PropertyGroup>
</Project>
