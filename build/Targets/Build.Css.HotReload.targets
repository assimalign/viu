<Project>
  <!--
    Development-only generated-asset regeneration for dotnet watch
    ([V01.01.12.30.04], #355; [PKG-4]).

    The .NET 10 watch host can hot-swap a static asset only after a watched file changes; it does not
    invoke arbitrary MSBuild targets for changes to generator inputs. The Browser SDK therefore
    exposes the versioned @(ViuGeneratedAsset) contract, collects each provider's asset description,
    and starts one project-scoped sidecar. The sidecar observes the declared files and roots, debounces
    one editor save, and invokes every distinct RegenerationTarget in one nested MSBuild operation.

    Providers own deterministic byte comparison and the declared removal behavior. The generated
    files are registered as static Watch items under wwwroot/, allowing the platform browser-refresh
    client to cache-bust and send UpdateStaticFile without changing Viu's runtime or JS-interop surface.

    Nothing here is a runtime or publish asset. Worker launch is limited to the design-time
    GenerateWatchList build performed by dotnet watch and defaults off outside Debug. The public
    contract is specified in sdks/Assimalign.Viu.Sdk.Browser/docs/GENERATED-ASSETS.md.
  -->

  <PropertyGroup>
    <ViuCssHotReloadEnabled Condition="'$(ViuCssHotReloadEnabled)' == '' and '$(Configuration)' == 'Debug'">true</ViuCssHotReloadEnabled>
    <ViuCssHotReloadEnabled Condition="'$(ViuCssHotReloadEnabled)' == ''">false</ViuCssHotReloadEnabled>
    <ViuCssHotReloadLaunchWorker Condition="'$(ViuCssHotReloadLaunchWorker)' == ''">true</ViuCssHotReloadLaunchWorker>
    <ViuCssHotReloadDebounceMilliseconds Condition="'$(ViuCssHotReloadDebounceMilliseconds)' == ''">100</ViuCssHotReloadDebounceMilliseconds>
    <ViuCssHotReloadTaskAssembly Condition="'$(ViuCssHotReloadTaskAssembly)' == ''">$(ViuOutputPathForSdk)\$(NETCoreSdkVersion)\sdks\Assimalign.Viu.Sdk.Browser\Tasks\Assimalign.Viu.Sdk.Browser.Tasks.dll</ViuCssHotReloadTaskAssembly>
    <ViuCssHotReloadWorkerAssembly Condition="'$(ViuCssHotReloadWorkerAssembly)' == ''">$(ViuOutputPathForSdk)\$(NETCoreSdkVersion)\sdks\Assimalign.Viu.Sdk.Browser\Watch\Assimalign.Viu.Sdk.CssHotReload.dll</ViuCssHotReloadWorkerAssembly>
    <ViuCssHotReloadStateFile Condition="'$(ViuCssHotReloadStateFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'viu', 'css-hot-reload', 'worker.state'))</ViuCssHotReloadStateFile>
    <ViuGeneratedAssetWorkerConfigurationFile Condition="'$(ViuGeneratedAssetWorkerConfigurationFile)' == ''">$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'viu', 'css-hot-reload', 'worker.state.configuration'))</ViuGeneratedAssetWorkerConfigurationFile>
  </PropertyGroup>

  <UsingTask TaskName="Assimalign.Viu.Sdk.Browser.Tasks.ViuStartCssHotReloadWorker"
             AssemblyFile="$(ViuCssHotReloadTaskAssembly)"
             Condition="'$(ViuCssHotReloadEnabled)' == 'true'" />
  <UsingTask TaskName="Assimalign.Viu.Sdk.Browser.Tasks.ViuWriteGeneratedAssetWorkerConfiguration"
             AssemblyFile="$(ViuCssHotReloadTaskAssembly)"
             Condition="'$(ViuCssHotReloadEnabled)' == 'true'" />

  <!-- Public extension hook. A seam-v1 provider declares a registration target with
       BeforeTargets="ViuCollectGeneratedAssets" and adds its documented @(ViuGeneratedAsset) item
       there. The empty target gives providers a stable hook without naming either side's internals. -->
  <Target Name="ViuCollectGeneratedAssets" />

  <!-- The Browser SDK's own component bundle consumes the same public contract as external providers,
       making the established component-CSS lane the generic seam's regression net. -->
  <Target Name="ViuRegisterSingleFileComponentCssGeneratedAsset"
          BeforeTargets="ViuCollectGeneratedAssets"
          Condition="'$(ViuBundleSingleFileComponentCss)' == 'true'"
          DependsOnTargets="_ViuResolveSingleFileComponentCssConfiguration">
    <ItemGroup>
      <_ViuSingleFileComponentGeneratedAssetWatchFile Remove="@(_ViuSingleFileComponentGeneratedAssetWatchFile)" />
      <_ViuSingleFileComponentGeneratedAssetWatchFile Include="%(ViuSingleFileComponent.FullPath)"
                                                       Condition="'%(ViuSingleFileComponent.Watch)' != 'false'" />
      <ViuGeneratedAsset Include="$(_ViuCssBundlePath)" KeepDuplicates="false">
        <WatchFiles>@(_ViuSingleFileComponentGeneratedAssetWatchFile->'%(FullPath)', ';')</WatchFiles>
        <WatchRoots>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)'))</WatchRoots>
        <WatchExtensions>.viu;.vue</WatchExtensions>
        <RegenerationTarget>ViuGenerateSingleFileComponentCss</RegenerationTarget>
        <StaticWebAssetPath>wwwroot/$(ViuSingleFileComponentCssBundleName)</StaticWebAssetPath>
        <RemovalBehavior>PreserveEmpty</RemovalBehavior>
      </ViuGeneratedAsset>
    </ItemGroup>
  </Target>

  <Target Name="_ViuPrepareGeneratedAssetWorkerConfiguration"
          DependsOnTargets="ViuCollectGeneratedAssets">
    <ItemGroup>
      <_ViuGeneratedAssetHotReloadExcludedDirectory Remove="@(_ViuGeneratedAssetHotReloadExcludedDirectory)" />
      <_ViuGeneratedAssetHotReloadExcludedDirectory Include="$([System.IO.Path]::GetFullPath('$(BaseIntermediateOutputPath)'))" />
      <_ViuGeneratedAssetHotReloadExcludedDirectory Include="$([System.IO.Path]::GetFullPath('$(BaseOutputPath)'))" />
      <_ViuGeneratedAssetHotReloadExcludedDirectory Include="$([System.IO.Path]::GetFullPath('$(ProjectDir).git'))" />
      <_ViuGeneratedAssetHotReloadExcludedDirectory Include="$([System.IO.Path]::GetFullPath('$(ProjectDir).vs'))" />
      <_ViuGeneratedAssetHotReloadExcludedDirectory Include="$([System.IO.Path]::GetFullPath('$(ProjectDir)node_modules'))" />
    </ItemGroup>
  </Target>

  <!-- Visual Studio launches the RunHost after an ordinary build, without dotnet watch's design-time
       watch-list pass. Persist the same descriptor set for that host while keeping process identity
       and refresh-session data launch-scoped. The writer compares final bytes so an incremental
       build does not create a false input change. Specified by [V01.01.12.30.05], issue #357. -->
  <Target Name="_ViuWriteGeneratedAssetWorkerConfiguration"
          AfterTargets="Build"
          Condition="'$(ViuCssHotReloadEnabled)' == 'true'
              and '$(Configuration)' == 'Debug'
              and '$(DotNetWatchBuild)' != 'true'
              and '$(DesignTimeBuild)' != 'true'
              and '$(ViuGeneratedAssetHotReload)' != 'true'
              and '$(_IsPublishing)' != 'true'"
          DependsOnTargets="_ViuPrepareGeneratedAssetWorkerConfiguration">
    <Delete Files="$(ViuGeneratedAssetWorkerConfigurationFile)"
            Condition="'@(ViuGeneratedAsset)' == '' and Exists('$(ViuGeneratedAssetWorkerConfigurationFile)')" />
    <ViuWriteGeneratedAssetWorkerConfiguration
      Condition="'@(ViuGeneratedAsset)' != ''"
      ConfigurationFilePath="$(ViuGeneratedAssetWorkerConfigurationFile)"
      ProjectPath="$(MSBuildProjectFullPath)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      StateFilePath="$(ViuCssHotReloadStateFile)"
      EventLogPath="$(ViuCssHotReloadEventLog)"
      DotNetHostPath="$(DotNetHostPath)"
      Configuration="$(Configuration)"
      TargetFramework="$(TargetFramework)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      GeneratedAssets="@(ViuGeneratedAsset)"
      ExcludedDirectories="@(_ViuGeneratedAssetHotReloadExcludedDirectory)"
      DebounceMilliseconds="$(ViuCssHotReloadDebounceMilliseconds)" />
  </Target>

  <Target Name="_ViuCollectGeneratedAssetHotReloadWatchItems"
          Condition="'$(ViuCssHotReloadEnabled)' == 'true' and '$(DotNetWatchBuild)' == 'true' and '$(DesignTimeBuild)' == 'true' and '$(ViuGeneratedAssetHotReload)' != 'true'"
          DependsOnTargets="_ViuPrepareGeneratedAssetWorkerConfiguration">
    <ItemGroup>
      <!-- StaticWebAssetPath deliberately starts at wwwroot/: dotnet watch strips that prefix and
           sends UpdateStaticFile for the same stable route used by the host page. -->
      <Watch Include="@(ViuGeneratedAsset)"
             StaticWebAssetPath="%(ViuGeneratedAsset.StaticWebAssetPath)"
             Condition="'%(ViuGeneratedAsset.StaticWebAssetPath)' != ''"
             KeepDuplicates="false" />

    </ItemGroup>

    <ViuStartCssHotReloadWorker
      Condition="'$(ViuCssHotReloadLaunchWorker)' == 'true' and '@(ViuGeneratedAsset)' != ''"
      WorkerAssemblyPath="$(ViuCssHotReloadWorkerAssembly)"
      ProjectPath="$(MSBuildProjectFullPath)"
      ProjectDirectory="$(MSBuildProjectDirectory)"
      StateFilePath="$(ViuCssHotReloadStateFile)"
      EventLogPath="$(ViuCssHotReloadEventLog)"
      DotNetHostPath="$(DotNetHostPath)"
      Configuration="$(Configuration)"
      TargetFramework="$(TargetFramework)"
      RuntimeIdentifier="$(RuntimeIdentifier)"
      GeneratedAssets="@(ViuGeneratedAsset)"
      ExcludedDirectories="@(_ViuGeneratedAssetHotReloadExcludedDirectory)"
      DebounceMilliseconds="$(ViuCssHotReloadDebounceMilliseconds)" />
  </Target>
</Project>
