<Project>

    <!-- Analyzer & Build Dependencies -->
    <ItemGroup>
        <_ViuPackage Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0" />
        <!-- Assimalign.Viu.Tooling.LanguageService consumes Microsoft.CodeAnalysis.CSharp at RUNTIME
             ([V01.01.12.07.04], #261): its assets must stay unrestricted so they flow into the
             self-contained Assimalign.Viu.Tooling.LanguageServer publish. Do not add PrivateAssets here. -->
        <_ViuPackage Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
        <!-- Removed ([V01.01.12.23], #259): Microsoft.CodeAnalysis.CSharp.Workspaces 5.0.0 and
             Microsoft.CodeAnalysis.Workspaces.MSBuild 5.0.0 had zero consumers, and the semantic
             IntelliSense increment deliberately ships without a workspace (SemanticModel over an
             artifact-fed CSharpCompilation — no MSBuildWorkspace, no MEF host). If a future
             increment adopts CompletionService, the Workspaces/Features packages must re-enter at
             the single Microsoft.CodeAnalysis 5.3.x line above (5.3.0 exists on nuget.org) WITHOUT
             PrivateAssets=all, mirroring the CSharp precedent, so their runtime assets flow into
             the self-contained language-server publish. -->
        <!-- Flagged for a separate cleanup item ([V01.01.12.23], #259): Microsoft.Build (unlike
             Microsoft.Build.Framework/Utilities.Core below) and Microsoft.Build.Locator also have
             zero consumers today. They are retained pending that item — do not fold their removal
             into unrelated changes. -->
        <_ViuPackage Include="Microsoft.Build" Version="18.7.1">
            <PrivateAssets>all</PrivateAssets>
            <!-- MSBuild supplies the task-host runtime; retain only compile assets. -->
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.Build.Framework" Version="18.7.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.Build.Utilities.Core" Version="18.7.1">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.Build.Locator" Version="1.11.2" />
        <_ViuPackage Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" Version="1.1.4" />
        <!-- Classic VSSDK packaging for the in-process Visual Studio extension and its companion
             registration VSIX. Its targets run under Visual Studio's MSBuild only, which is why
             both projects stay out of Assimalign.Viu.slnx and build through the scripts in
             extensions\VisualStudio\. -->
        <_ViuPackage Include="Microsoft.VSSDK.BuildTools" Version="17.14.2120">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </_ViuPackage>
        <!-- The editor contracts the in-process MEF parts of Assimalign.Viu.VisualStudio compile
             against: content types and ordering metadata (CoreUtility), the buffer/snapshot model
             (Text.Data), classification (Text.Logic), and the WPF format definitions that carry the
             Viu palette (Text.UI.Wpf). Pinned at 17.14 because that is the floor the VSIX manifest
             declares; Visual Studio supplies the implementations, so runtime assets are excluded and
             nothing from these packages enters the container. -->
        <_ViuPackage Include="Microsoft.VisualStudio.CoreUtility" Version="17.14.249">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.VisualStudio.Text.Data" Version="17.14.249">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.VisualStudio.Text.Logic" Version="17.14.249">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="17.14.249">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <!-- Text.UI.Wpf asks for an Imaging.Interop.14.0.DesignTime build that was never published,
             so NuGet resolves upward and warns (NU1603). Pinning the transitive dependency on the
             same 17.14 line makes the resolution explicit instead of approximate. -->
        <_ViuPackage Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="17.14.40254">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <!-- The classic in-process Language Server Protocol client API: ILanguageClient, the
             Connection stream pair ViuLanguageClient hands Visual Studio, and the
             CodeRemoteContentDefinition base the viu content type derives from so the editor's
             language-server features attach to a .viu buffer. Same 17.14 line and same
             compile-only stance as the editor packages above; Visual Studio's own LanguageServer
             extension registers a 0.0.0.0-18.x binding redirect for the assembly, so an extension
             compiled against 17.14 binds to whatever the running IDE ships. -->
        <_ViuPackage Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <!-- AsyncEventHandler<T>, the type of ILanguageClient's StartAsync/StopAsync events, which
             ViuLanguageClient declares and raises. A transitive dependency of the client package,
             pinned explicitly because it is compiled against directly. -->
        <_ViuPackage Include="Microsoft.VisualStudio.Threading" Version="17.13.2">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <!-- Two more transitive dependencies of the client package whose requested builds were never
             published, so NuGet resolves upward and warns (NU1603) - the same situation as
             Imaging.Interop above. Pinned at the builds NuGet picks anyway, which makes the
             resolution explicit rather than approximate. -->
        <_ViuPackage Include="Microsoft.VisualStudio.Telemetry" Version="17.14.2">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <_ViuPackage Include="Microsoft.VisualStudio.Utilities" Version="17.13.40008">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
        <!-- ViuLanguageServerConfiguration parses language-server.json. On the .NET Framework line a
             classic VSIX compiles against, System.Text.Json is a package rather than part of the
             framework; devenv.exe.config redirects the whole 0.0.0.0-10.x range onto the copy
             Visual Studio ships, so only compile assets are taken and the VSIX carries none of it. -->
        <_ViuPackage Include="System.Text.Json" Version="9.0.13">
            <PrivateAssets>all</PrivateAssets>
            <ExcludeAssets>runtime</ExcludeAssets>
        </_ViuPackage>
    </ItemGroup>

    <!-- Benchmark Dependencies -->
    <ItemGroup>
        <!-- BenchmarkDotNet hosts the DOM-free micro/meso benchmarks ([V01.01.11.04], #88): reactivity
             track/trigger and renderer diff/patch on the in-memory test adapter, on CoreCLR. It never
             ships and is not trimmed/AOT'd (bench project, like the tests). Restored from dotnet-public. -->
        <_ViuPackage Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <!-- XUnit Test Dependencies-->
    <ItemGroup>
        <_ViuPackage Include="Shouldly" Version="4.3.0" />
        <_ViuPackage Include="xunit" Version="2.9.3" />
        <_ViuPackage Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
        <_ViuPackage Include="xunit.runner.visualstudio" Version="3.1.5"
            IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive"
            PrivateAssets="all" />
        <_ViuPackage Include="coverlet.collector" Version="10.0.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </_ViuPackage>
    </ItemGroup>

    <!-- #region: Package Reference Update -->
    <ItemGroup>
        <!--
            Metadata declared on the central catalog does not flow through an Update automatically.
            Copy every package-control field used above while preserving project-local metadata when
            the catalog leaves that field unspecified.
        -->
        <ViuPackageReference Update="@(_ViuPackage)" Version="%(_ViuPackage.Version)">
            <PrivateAssets Condition="'%(_ViuPackage.PrivateAssets)' != ''">%(_ViuPackage.PrivateAssets)</PrivateAssets>
            <IncludeAssets Condition="'%(_ViuPackage.IncludeAssets)' != ''">%(_ViuPackage.IncludeAssets)</IncludeAssets>
            <ExcludeAssets Condition="'%(_ViuPackage.ExcludeAssets)' != ''">%(_ViuPackage.ExcludeAssets)</ExcludeAssets>
        </ViuPackageReference>
        <PackageReference Include="@(ViuPackageReference)" />
        <ViuPackageReference Remove="@(ViuPackageReference)" />
    </ItemGroup>
    <!-- #endregion -->
</Project>
