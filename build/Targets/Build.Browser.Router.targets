<Project>
    <!--
        WasmAppHost serves the consuming application's source wwwroot. Flow the Browser.Router
        package's browser-history bridge into that tree under the standard static-web-asset
        URL used by BrowserRouterHistory's lazy browser-bridge initialization.
    -->
    <Target Name="ViuFlowBrowserRouterWebAssets"
            BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
            Condition="'$(UsingMicrosoftNETSdkWebAssembly)' == 'true'">
        <ItemGroup>
            <_ViuBrowserRouterWebAsset Include="$(MSBuildThisFileDirectory)..\assets\Assimalign.Viu.Browser.Router\**\*" />
        </ItemGroup>
        <Copy SourceFiles="@(_ViuBrowserRouterWebAsset)"
              DestinationFiles="@(_ViuBrowserRouterWebAsset->'$(MSBuildProjectDirectory)\wwwroot\_content\Assimalign.Viu.Browser.Router\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true"
              Condition="'@(_ViuBrowserRouterWebAsset)' != ''" />
        <ItemGroup>
            <_ViuBrowserRouterWebAsset Remove="@(_ViuBrowserRouterWebAsset)" />
        </ItemGroup>
    </Target>
</Project>
